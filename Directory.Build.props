<Project>

  <!-- 仓库级公共属性：所有项目共享，项目文件只保留差异项 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 应用版本唯一来源：日常发版只改这一处；CI 发布时由标签通过 -p:Version 覆盖。
       程序集版本、界面显示与关于页文案都由该值派生，项目文件不要再单独声明版本属性 -->
  <PropertyGroup>
    <Version>0.1.1-alpha</Version>
  </PropertyGroup>

  <!-- 本应用仅面向 Windows（DPAPI/GDI+/硬链接/命名管道 CurrentUserOnly）；
       程序集级声明让 CA1416 只在真正的跨平台边界报告，而不是每个调用点 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
