{
  "id": "com.hd2mimnt.samples.theme",
  "name": "主题示例",
  "version": "1.0.0",
  "author": "HD2Mimnt",
  "description": "演示用设计令牌覆盖配色、圆角与字号：不改代码，也能换一套外观。",
  "apiVersion": "1.2.0",
  "runtime": "net10.0",
  "permissionMode": "Sandbox",
  "requestedPermissions": ["ui.theme"],
  "assembly": "ThemeShowcase.dll",
  "entryType": "HD2Mimnt.Samples.ThemeShowcase.ThemeShowcasePlugin",

  "ui": {
    "pages": [
      {
        "id": "theme-guide",
        "title": "主题示例",
        "icon": "Sliders",
        "description": "这是一页完全由声明描述的页面，用来展示主题令牌支持的范围。",
        "blocks": [
          {
            "type": "markdown",
            "text": "## 设计令牌\n\n主题只接受**白名单令牌**，值必须是字面量，插件无法写入样式代码。\n\n在「设置 → 插件」页面点击主题按钮即可应用，随时可以一键恢复默认。"
          },
          {
            "type": "facts",
            "facts": [
              { "label": "颜色", "value": "accent / surface0-3 / border / textPrimary / textSecondary / success / warning / error" },
              { "label": "圆角", "value": "cardCornerRadius / overlayCornerRadius / notificationCornerRadius" },
              { "label": "字号", "value": "pageTitleFontSize / sectionTitleFontSize / bodyFontSize / captionFontSize" }
            ]
          },
          {
            "type": "notice",
            "tone": "info",
            "title": "边界",
            "text": "超出白名单或格式非法的令牌会被忽略，并在应用结果中提示。"
          }
        ]
      }
    ],
    "themes": [
      {
        "id": "midnight",
        "name": "午夜蓝",
        "description": "偏冷的深色配色，适合夜间使用。",
        "tokens": {
          "accent": "#4C8DFF",
          "accentStrong": "#7AAEFF",
          "surface0": "#0B0F16",
          "surface1": "#121824",
          "surface2": "#1A2230",
          "surface3": "#242E40",
          "border": "#2E3A4C",
          "textPrimary": "#E6EDF7",
          "textSecondary": "#A9B6C8",
          "textMuted": "#74839A",
          "cardCornerRadius": "10",
          "bodyFontSize": "14"
        }
      },
      {
        "id": "amber",
        "name": "琥珀暖光",
        "description": "高对比暖色，突出强调色与卡片层次。",
        "tokens": {
          "accent": "#FFB020",
          "accentStrong": "#FFC94D",
          "surface1": "#161310",
          "surface2": "#201B15",
          "textPrimary": "#FFF4E3",
          "textSecondary": "#D8C7AE",
          "cardCornerRadius": "14",
          "overlayCornerRadius": "14",
          "sectionTitleFontSize": "20"
        }
      }
    ]
  }
}
