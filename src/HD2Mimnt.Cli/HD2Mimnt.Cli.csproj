<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与 Worker 相同：显式固定为框架依赖部署。 -->
    <PublishSelfContained>false</PublishSelfContained>
    <!-- 发布不生成 *.deps.json，见 UI 工程同名属性说明。 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- 薄客户端只做解析/转发，不引用 Application/Infrastructure；
         NativeAOT 版本由发布流水线单独产出（AOT 项目被 UI 引用会把自包含产物带进 lib/ 闭包，见 docs/cli/README.md）。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 发布版托管依赖在应用目录的 lib/ 下，入口程序集自带模块初始化器完成解析 -->
    <Compile Include="..\Shared\LibAssemblyResolver.cs" Link="LibAssemblyResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HD2Mimnt.Core\HD2Mimnt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HD2Mimnt.Tests" />
  </ItemGroup>

</Project>
