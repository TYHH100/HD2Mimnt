<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HD2Mimnt.Core\HD2Mimnt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\7zip\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Config\LoaderCatalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Config\LoaderCatalog.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅为 Services/ImageLoaderService、ImageCacheService 提供编译期 Avalonia.Base 类型（Bitmap/PixelSize/
         CreateScaledBitmap）。ExcludeAssets="runtime" 使 Avalonia 不流入 Worker/Cli 的发布与 deps.json——
         这两个子进程不消费图像服务；图像服务实际消费方只有 UI，其自身另行完整引用 Avalonia。
         勿改为无排除的完整引用，否则 Worker/Cli 单文件包被迫捆绑整套 Avalonia，发布体积放大约 4MB/个；
         也勿在 Worker/Cli 路径新增对图像服务的调用（运行时会因缺少 Avalonia.Base 而 TypeLoadException）。 -->
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="Ww2Ogg.Core" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

  <!-- 仅测试工程可见内部实现（贴图解码助手等）；不对其他程序集开放 -->
  <ItemGroup>
    <InternalsVisibleTo Include="HD2Mimnt.Tests" />
  </ItemGroup>

</Project>
