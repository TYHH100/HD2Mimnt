<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HD2Mimnt.UI.Converters"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Surface0Brush" Color="#F3F5F8"/>
                    <SolidColorBrush x:Key="Surface1Brush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Surface2Brush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="Surface3Brush" Color="#EEF2F6"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#D7DEE8"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B5C0CF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202124"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555A60"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#697586"/>
                    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E5EAF1"/>
                    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#DCE9FB"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#1A6FCE"/>
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#125BB0"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#16794A"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#A15C00"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318"/>
                    <SolidColorBrush x:Key="DisabledBrush" Color="#8A94A3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Surface0Brush" Color="#0D131D"/>
                    <SolidColorBrush x:Key="Surface1Brush" Color="#111A2A"/>
                    <SolidColorBrush x:Key="Surface2Brush" Color="#152033"/>
                    <SolidColorBrush x:Key="Surface3Brush" Color="#1B2841"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#223049"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4D6E"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EEF8"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AAAC6"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7E9E"/>
                    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#1A2740"/>
                    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#16305E"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
                    <SolidColorBrush x:Key="DisabledBrush" Color="#64748B"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:EqualConverter x:Key="EqualConverter"/>
        <converters:NotNullConverter x:Key="NotNullConverter"/>
        <converters:TimeAgoConverter x:Key="TimeAgoConverter"/>
        <converters:LevelToColorConverter x:Key="LevelToColorConverter"/>
        <converters:LevelToIconConverter x:Key="LevelToIconConverter"/>

        <CornerRadius x:Key="FlatCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="SubtleCornerRadius">2</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
        <!-- 卡片/框架填充：默认不透明；启用背景图或调整透明度时由 MainWindowViewModel 运行时重建（随主题换色） -->
        <SolidColorBrush x:Key="CardFillBrush" Color="#FF152033"/>
        <SolidColorBrush x:Key="ChromeFillBrush" Color="#FF111A2A"/>
        <SolidColorBrush x:Key="ContentFillBrush" Color="#FF0D131D"/>
        <x:Double x:Key="Space4">4</x:Double>
        <x:Double x:Key="Space8">8</x:Double>
        <x:Double x:Key="Space12">12</x:Double>
        <x:Double x:Key="Space16">16</x:Double>
        <x:Double x:Key="Space20">20</x:Double>
        <x:Double x:Key="Space24">24</x:Double>
        <x:Double x:Key="Space32">32</x:Double>
        <x:Double x:Key="PageTitleFontSize">22</x:Double>
        <x:Double x:Key="SectionTitleFontSize">16</x:Double>
        <x:Double x:Key="BodyFontSize">14</x:Double>
        <x:Double x:Key="SecondaryFontSize">12</x:Double>
        <x:Double x:Key="CaptionFontSize">11</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
        <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
        <Style Selector="TextBlock.accent-text"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
        <Style Selector="controls|UtilityIcon"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
        <Style Selector="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,4"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/></Style>
        <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Border.section"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="0,12"/><Setter Property="CornerRadius" Value="0"/></Style>
        <Style Selector="Button.tool-row"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CornerRadius" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,12"/></Style>
        <Style Selector="Button.tool-row:pointerover"><Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/></Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.body-text">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.secondary-text">
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.caption-text">
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Button.nav-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="{DynamicResource FlatCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.nav-button:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.nav-button.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>

        <Style Selector="Button.tertiary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.tertiary:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Icon Button Style -->
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.icon-button:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Badge Style -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <Style Selector="Border.badge > TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Status Indicator Style -->
        <Style Selector="Ellipse.status-indicator">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- RadioButton Navigation Style -->
        <Style Selector="RadioButton.nav-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.nav-button:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        </Style>

        <Style Selector="RadioButton.nav-button:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="RadioButton.nav-button:checked /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style Selector="RadioButton.nav-button:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Filter Button Style -->
        <Style Selector="RadioButton.filter-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.filter-button:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>

        <Style Selector="RadioButton.filter-button:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="RadioButton.filter-button:checked /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="RadioButton.filter-button:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ListBox Style -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
        </Style>

        <!-- ComboBox Style -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>

        <!-- CheckBox Style -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button:focus, TextBox:focus, ComboBox:focus, RadioButton:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Application.Styles>
</Application>
