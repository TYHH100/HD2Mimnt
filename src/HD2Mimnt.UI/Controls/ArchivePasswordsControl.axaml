<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels" xmlns:loc="using:HD2Mimnt.UI.Localization"
             xmlns:models="using:HD2Mimnt.Application.Services"
             x:Class="HD2Mimnt.UI.Controls.ArchivePasswordsControl" x:DataType="vm:ArchivePasswordsViewModel">
  <Expander IsVisible="{Binding Available}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <Expander.Header><TextBlock Text="{loc:Loc ArchivePasswords.Library}"/></Expander.Header>
    <StackPanel Spacing="8" IsEnabled="{Binding !IsBusy}">
      <TextBlock Text="{loc:Loc ArchivePasswords.Hint}" TextWrapping="Wrap" Classes="caption-text"/>
      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{loc:Loc ArchivePasswords.DefaultLabel}"/><TextBlock Text="{Binding DefaultName}" FontWeight="SemiBold"/></StackPanel>
      <ComboBox Name="SavedArchivePasswords" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"
                PlaceholderText="{loc:Loc ArchivePasswords.Select}">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ArchivePasswordEntry"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBox Name="ArchivePasswordName" Text="{Binding Name}" PlaceholderText="{loc:Loc ArchivePasswords.Name}"/>
      <TextBox Name="ArchivePasswordInput" Text="{Binding Password}" PasswordChar="●" PlaceholderText="{loc:Loc ArchivePasswords.Password}"/>
      <CheckBox Content="{loc:Loc ArchivePasswords.MakeDefault}" IsChecked="{Binding MakeDefault}"/>
      <WrapPanel>
        <Button Content="{loc:Loc ArchivePasswords.New}" Command="{Binding NewCommand}" Margin="0,0,8,4"/>
        <Button Content="{loc:Loc Common.Save}" Command="{Binding SaveCommand}" Margin="0,0,8,4"/>
        <Button Content="{loc:Loc Common.Delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,4"/>
        <Button Content="{loc:Loc ArchivePasswords.ClearDefault}" Command="{Binding ClearDefaultCommand}" Margin="0,0,0,4"/>
      </WrapPanel>
      <TextBlock Text="{loc:LocalizedBinding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </Expander>
</UserControl>
