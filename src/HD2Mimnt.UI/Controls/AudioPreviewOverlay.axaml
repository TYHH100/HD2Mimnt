<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Controls.AudioPreviewOverlay" x:DataType="vm:AudioPreviewViewModel"
             IsVisible="{Binding IsOpen, FallbackValue=False}" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
  <!-- 播放/暂停字形用 Segoe MDL2 Assets（\uE768 播放 / \uE769 暂停 / \uE71A 停止）；
       FASymbol 没有 Pause 成员，勿改回 UtilityIcon。 -->
  <UserControl.Styles>
    <Style Selector="ListBox Border.entryRow">
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
      </Style>
    </Style>
    <Style Selector="ListBox Border.entryRow.playing">
      <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
    </Style>
    <Style Selector="ListBox TextBlock.replaced">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource OverlayScrimBrush}">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource OverlayCornerRadius}" Margin="12" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock x:Name="AudioPreviewTitle" Text="{loc:Loc AudioPreview.Title}" Classes="section-title"/>
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
          </StackPanel>
          <Button x:Name="CloseAudioPreviewButton" Grid.Column="1" Classes="icon-button" Command="{Binding CloseCommand}" ToolTip.Tip="{loc:Loc Common.Close}">
            <controls:UtilityIcon Kind="Close"/>
          </Button>
        </Grid>

        <!-- 工具条：播放/暂停、停止、进度、音量、过滤 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" IsEnabled="{Binding HasEntries}">
          <Button x:Name="ToggleAudioPlaybackButton" Command="{Binding TogglePlaybackCommand}" ToolTip.Tip="{Binding PlaybackText}" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding PlaybackGlyph}"/>
          </Button>
          <Button x:Name="StopAudioButton" Grid.Column="1" Command="{Binding StopAudioCommand}" ToolTip.Tip="{Binding StopText}" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;"/>
          </Button>
          <Slider x:Name="AudioPositionSlider" Grid.Column="2" Minimum="0" Maximum="{Binding AudioDurationSeconds}"
                  Value="{Binding AudioPositionSeconds}"
                  VerticalAlignment="Center" MinWidth="200"/>
          <TextBlock Grid.Column="3" Text="{Binding AudioTimeText}" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
          <TextBlock Grid.Column="4" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" FontSize="12"/>
          <Slider x:Name="AudioVolumeSlider" Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding AudioVolumePercent}" Width="100" VerticalAlignment="Center"/>
          <TextBox x:Name="AudioFilterBox" Grid.Column="6" Text="{Binding AudioFilterText}" PlaceholderText="{loc:Loc AudioPreview.Title}" MinWidth="140" VerticalAlignment="Center"/>
          <CheckBox x:Name="OnlyShowModifiedCheck" Grid.Column="8" Content="{loc:Loc AudioPreview.OnlyShowModified}" IsChecked="{Binding OnlyShowModified}"
                    IsVisible="{Binding HasOriginalComparison}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 条目列表：分组头 + 条目的扁平虚拟化列表（语音包可达数千条目，必须保持 ListBox 虚拟化） -->
        <ListBox x:Name="AudioEntriesList" Grid.Row="2" ItemsSource="{Binding Rows}">
          <ListBox.DataTemplates>
            <DataTemplate x:DataType="vm:AudioGroupHeaderRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding PatchPath}" Classes="caption-text" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption-text" Text="{Binding EntryCount}"/>
              </Grid>
            </DataTemplate>
            <DataTemplate x:DataType="vm:AudioEntryRow">
              <Border Classes="entryRow" Classes.playing="{Binding IsPlaying}" CornerRadius="4" Padding="6,4">
                <Grid ColumnDefinitions="Auto,90,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                  <Button Command="{Binding $parent[ListBox].((vm:AudioPreviewViewModel)DataContext).ToggleEntryPlaybackCommand}"
                          CommandParameter="{Binding}" IsEnabled="{Binding IsPlayable}"
                          ToolTip.Tip="{Binding DisplayTitle}" VerticalAlignment="Center" Padding="4,2">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding PlayGlyph}" FontSize="12"/>
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontFamily="Consolas" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding OriginText}" Classes="caption-text" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="caption-text" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding FormatText}" Classes="caption-text" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding ModifiedText}" Classes="caption-text" VerticalAlignment="Center"
                             IsVisible="{Binding ModifiedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Classes.replaced="{Binding IsReplaced}"/>
                  <TextBlock Grid.Column="6" Text="{Binding IssueText}" Classes="caption-text" VerticalAlignment="Center"
                             IsVisible="{Binding IssueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <!-- 消息条 -->
        <TextBlock x:Name="AudioMessageTextBlock" Grid.Row="3" Text="{Binding AudioMessageText}" IsVisible="{Binding HasAudioMessage}"
                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" MaxHeight="40"
                   TextTrimming="WordEllipsis" ToolTip.Tip="{Binding AudioMessageText}"/>

        <!-- 统计行 -->
        <StackPanel Grid.Row="4" Spacing="4">
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ComparisonHintText}" IsVisible="{Binding ComparisonHintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes="caption-text" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
