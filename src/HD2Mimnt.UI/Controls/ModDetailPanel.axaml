<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="HD2Mimnt.UI.Controls.ModDetailPanel"
             x:DataType="vm:ModItemViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.detail-label">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBlock.detail-value">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Surface1Brush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1,0,0,0"
          Padding="24">

    <ScrollViewer>
      <StackPanel Spacing="16">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0"
                     Text="模组详情"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>

          <Button Grid.Column="2"
                  Content="✕"
                  Classes="icon-button"
                  Command="{Binding CloseDetailPanelCommand}"
                  ToolTip.Tip="关闭"/>
        </Grid>

        <!-- Mod Icon -->
        <Border Classes="section">
          <StackPanel>
            <Border Width="120"
                    Height="120"
                    CornerRadius="6"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    Tapped="Icon_Tapped"
                    Cursor="Hand"
                    ToolTip.Tip="点击预览原图">
              <Image Source="{Binding IconBitmap}"
                     Stretch="UniformToFill"/>
            </Border>

            <!-- Mod Name -->
            <TextBlock Text="{Binding Name}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Version -->
            <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Status Badges -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="状态" Classes="detail-label"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource SuccessBrush}"
                      CornerRadius="4"
                      Padding="8,4"
                      IsVisible="{Binding IsProfileEnabled}">
                <TextBlock Text="已启用"
                           FontSize="12"
                           Foreground="White"/>
              </Border>

              <Border Background="{DynamicResource DisabledBrush}"
                      CornerRadius="4"
                      Padding="8,4"
                      IsVisible="{Binding IsProfileMemberDisabled}">
                <TextBlock Text="已加入 · 未启用"
                           FontSize="12"
                           Foreground="White"/>
              </Border>

              <Border Background="{DynamicResource AccentBrush}"
                      CornerRadius="4"
                      Padding="8,4"
                      IsVisible="{Binding IsDeployed}">
                <TextBlock Text="已部署"
                           FontSize="12"
                           Foreground="White"/>
              </Border>

              <Border Background="{DynamicResource TextMutedBrush}"
                      CornerRadius="4"
                      Padding="8,4"
                      IsVisible="{Binding IsNotInCurrentProfile}">
                <TextBlock Text="未加入当前 Profile"
                           FontSize="12"
                           Foreground="White"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Basic Info -->
        <Border Classes="section" IsVisible="{Binding HasPlatformLink}">
          <StackPanel Spacing="8">
            <TextBlock Text="模组链接" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PlatformLinkSummary}" TextWrapping="Wrap" />
            <TextBox Text="{Binding PlatformLinkUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="基本信息"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="作者" Classes="detail-label"/>
            <TextBlock Text="{Binding Author}" Classes="detail-value"/>

            <TextBlock Text="分类" Classes="detail-label"/>
            <TextBlock Text="{Binding CategoryDisplay}" Classes="detail-value" TextWrapping="Wrap" ToolTip.Tip="{Binding ResourceTypeDetails}"/>

            <TextBlock Text="描述" Classes="detail-label"/>
            <TextBlock Text="{Binding Description}" Classes="detail-value"/>

            <TextBlock Text="标签"
                       Classes="detail-label"
                       IsVisible="{Binding HasTags}"/>
            <ItemsControl ItemsSource="{Binding Tags}"
                          IsVisible="{Binding HasTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Surface3Brush}"
                          CornerRadius="4"
                          Padding="8,4"
                          Margin="0,0,8,8">
                    <TextBlock Text="{Binding}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- File Info -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="文件信息"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="路径" Classes="detail-label"/>
            <TextBlock Text="{Binding Path}" Classes="detail-value"/>

            <TextBlock Text="大小" Classes="detail-label"/>
            <TextBlock Text="{Binding SizeFormatted}" Classes="detail-value"/>

            <TextBlock Text="哈希" Classes="detail-label"/>
            <TextBlock x:Name="ModHashValue" Text="{Binding HashDisplay}"
                       Classes="detail-value"
                       TextWrapping="Wrap" FontFamily="Consolas"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCalculatingHash}" Margin="0,4,0,8"/>
          </StackPanel>
        </Border>

        <!-- Timestamps -->
        <Border Classes="section">
          <StackPanel>
            <TextBlock Text="时间信息"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="导入时间" Classes="detail-label"/>
            <TextBlock Text="{Binding ImportedAtDisplay}"
                       Classes="detail-value"/>

            <TextBlock Text="修改时间" Classes="detail-label"/>
            <TextBlock Text="{Binding ModifiedAtDisplay}"
                       Classes="detail-value"/>
          </StackPanel>
        </Border>

        <!-- Actions -->
        <Border Classes="section">
          <StackPanel Spacing="8">
            <TextBlock Text="操作"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <Button Content="{Binding EnableButtonText}"
                    Command="{Binding ToggleEnabledCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Height="36"/>

            <Button Content="从当前 Profile 移除"
                    Command="{Binding RemoveFromProfileCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    Height="36"
                    IsVisible="{Binding IsInCurrentProfile}"/>

            <Button Content="从 Library 删除 Mod"
                    Command="{Binding DeleteCommand}"
                    Classes="danger"
                    HorizontalAlignment="Stretch"
                    Height="36"/>

            <Button Content="在文件夹中打开"
                    Command="{Binding OpenFolderCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    Height="36"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
