<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels" xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Controls.ModOptionsSelector" x:DataType="vm:IModOptionsSelection">
  <UserControl.Resources>
    <DataTemplate x:Key="ModOptionHeaderTemplate" x:DataType="vm:ProfileModOptionCardViewModel">
      <Grid ColumnDefinitions="64,*,Auto,Auto" ColumnSpacing="12">
        <Border Width="64" Height="64" CornerRadius="6" Background="{DynamicResource Surface3Brush}"
                PointerPressed="OptionPreview_PointerPressed" Tapped="PreviewImage_Tapped"
                Cursor="Hand" ToolTip.Tip="{loc:Loc UI.PreviewOriginalImage}">
          <Panel>
            <TextBlock Text="{loc:Loc UI.NoPreview}" Classes="caption-text" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsVisible="{Binding !HasImage}"/>
            <Image Source="{Binding Image}" Width="64" Height="64" Stretch="Uniform"/>
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
          <TextBlock Text="{Binding DisplayDescription}" Classes="caption-text" TextWrapping="Wrap"
                     IsVisible="{Binding HasDescription}"/>
        </StackPanel>
        <Border Grid.Column="2" Width="32" IsVisible="{Binding HasSubOptions}" IsHitTestVisible="False"/>
        <CheckBox Grid.Column="3" Width="32" VerticalAlignment="Center"
                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                  Command="{Binding $parent[UserControl].((vm:IModOptionsSelection)DataContext).ToggleOptionCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{loc:Loc UI.EnableDisableOptionDisabledFilesAreExcludedFromDeployment}"/>
      </Grid>
    </DataTemplate>
    <!-- 一级组件卡片：进入二级页配置该组件的选项与子选项。 -->
    <DataTemplate x:Key="ModOptionGroupTemplate" x:DataType="vm:ProfileModOptionGroupViewModel">
      <Grid ColumnDefinitions="64,*,Auto,Auto" ColumnSpacing="12">
        <Border Width="64" Height="64" CornerRadius="6" Background="{DynamicResource Surface3Brush}"
                PointerPressed="OptionPreview_PointerPressed" Tapped="PreviewImage_Tapped"
                Cursor="Hand" ToolTip.Tip="{loc:Loc UI.PreviewOriginalImage}">
          <Panel>
            <TextBlock Text="{loc:Loc UI.NoPreview}" Classes="caption-text" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsVisible="{Binding !HasImage}"/>
            <Image Source="{Binding Image}" Width="64" Height="64" Stretch="Uniform"/>
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                    Tapped="GroupCard_Tapped" Cursor="Hand">
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
          <TextBlock Text="{Binding DisplayDescription}" Classes="caption-text" TextWrapping="Wrap"
                     IsVisible="{Binding HasDescription}"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Content="{loc:Loc UI.Configure}"
                Command="{Binding $parent[UserControl].((vm:IModOptionsSelection)DataContext).OpenGroupCommand}"
                CommandParameter="{Binding}" IsVisible="{Binding CanOpen}"/>
        <CheckBox Grid.Column="3" Width="32" VerticalAlignment="Center"
                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                  Command="{Binding $parent[UserControl].((vm:IModOptionsSelection)DataContext).ToggleGroupCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{loc:Loc UI.EnableDisableOptionDisabledFilesAreExcludedFromDeployment}"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

<UserControl.Styles>
  <Style Selector="Expander.mod-option /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- 原生箭头放在头部预留槽位，所有选项的勾选框保持最右侧对齐。 -->
  <Style Selector="Expander.mod-option /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,44,0"/>
  </Style>
  <!-- 二级子选项行尾的展开箭头：无边框小按钮，只控制第三层嵌套变体的可见性，不参与分支选择。
       覆盖默认 ToggleButton 模板：原生模板在 IsChecked（展开）态画蓝底选中框，盖住箭头内容；
       裸模板只保留 chevron 内容（折叠右向 / 展开旋转 90°），两种状态外观一致。 -->
  <Style Selector="ToggleButton.nested-expand-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- 复用 FluentAvalonia 原生 ListBoxItem 模板，只调整内容布局，不覆盖选中态模板。 -->
  <Style Selector="ListBoxItem.option-choice-item">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>
</UserControl.Styles>
            <StackPanel>
              <!-- 一级：HD2IAS 组件列表（进入二级页配置组件内选项） -->
              <ItemsControl ItemsSource="{Binding GroupCards}" IsVisible="{Binding ShowGroupList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileModOptionGroupViewModel">
                    <Border Classes="option-card" Margin="0,6">
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModOptionGroupTemplate}"
                                      HorizontalContentAlignment="Stretch"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- v1：选项卡片（独立开关 + 子选项多选一）；组件页只显示当前组件选项 -->
              <ItemsControl ItemsSource="{Binding VisibleOptionCards}"
                            IsVisible="{Binding ShowOptionList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileModOptionCardViewModel">
                    <Border Classes="option-card" Margin="0,6">
                      <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModOptionHeaderTemplate}"
                                        HorizontalContentAlignment="Stretch" IsVisible="{Binding !HasSubOptions}"/>
                        <!-- 选项头部直接展开子选项，勾选框与预览图保留独立操作。 -->
                        <Expander Classes="mod-option" Header="{Binding}" HeaderTemplate="{StaticResource ModOptionHeaderTemplate}"
                                  IsExpanded="False" Padding="0,8,0,0" Background="Transparent" BorderThickness="0"
                                  HorizontalAlignment="Stretch" IsVisible="{Binding HasSubOptions}">
                          <ItemsControl ItemsSource="{Binding SubOptions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileModSubOptionChoiceViewModel">
                              <ListBoxItem Theme="{StaticResource ViewModelSelectableListBoxItemTheme}" Classes="option-choice-item"
                                           Tapped="SubChoice_Tapped">
                                <Border Classes="sub-choice">
                                  <StackPanel Spacing="0">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                      <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource Surface3Brush}"
                                              Tapped="PreviewImage_Tapped" Cursor="Hand" ToolTip.Tip="{loc:Loc UI.PreviewOriginalImage}">
                                        <Image Source="{Binding Image}" Width="40" Height="40" Stretch="Uniform"/>
                                      </Border>
                                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"/>
                                        <TextBlock Text="{Binding DisplayDescription}" Classes="caption-text"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                      </StackPanel>
                                      <!-- 行尾展开箭头：有嵌套变体时显示，只切换第三层可见性，不影响分支选择。 -->
                                      <ToggleButton Grid.Column="2" Classes="nested-expand-toggle"
                                                    IsChecked="{Binding IsExpanded}" IsVisible="{Binding HasSubOptions}"
                                                    Tapped="NestedExpand_Tapped"
                                                    ToolTip.Tip="{loc:Loc UI.CollapseExpandGroup}">
                                        <Panel>
                                          <controls:UtilityIcon Kind="Chevron" IsVisible="{Binding !IsExpanded}"/>
                                          <controls:UtilityIcon Kind="Chevron" IsVisible="{Binding IsExpanded}"
                                                                 RenderTransformOrigin="50%,50%">
                                            <controls:UtilityIcon.RenderTransform>
                                              <RotateTransform Angle="90"/>
                                            </controls:UtilityIcon.RenderTransform>
                                          </controls:UtilityIcon>
                                        </Panel>
                                      </ToggleButton>
                                    </Grid>
                                    <!-- 第三层：嵌套变体（叶子 Include 才决定部署文件），默认折叠，行尾箭头展开。 -->
                                    <ItemsControl ItemsSource="{Binding SubOptions}" IsVisible="{Binding IsExpanded}" Margin="8,4,0,4">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProfileModSubOptionChoiceViewModel">
                                          <ListBoxItem Theme="{StaticResource ViewModelSelectableListBoxItemTheme}"
                                                       Classes="option-choice-item nested-choice"
                                                       Tapped="SubChoice_Tapped" Margin="0,2">
                                            <Border Classes="sub-choice">
                                              <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                                                <Border Width="32" Height="32" CornerRadius="4"
                                                        Background="{DynamicResource Surface3Brush}"
                                                        Tapped="PreviewImage_Tapped" Cursor="Hand"
                                                        ToolTip.Tip="{loc:Loc UI.PreviewOriginalImage}">
                                                  <Image Source="{Binding Image}" Width="32" Height="32" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                             ToolTip.Tip="{Binding Name}"/>
                                                  <TextBlock Text="{Binding DisplayDescription}" Classes="caption-text"
                                                             TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                                </StackPanel>
                                              </Grid>
                                            </Border>
                                          </ListBoxItem>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Border>
                              </ListBoxItem>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- v0：互斥选择列表（部署时只使用选中的那个子目录） -->
              <ItemsControl ItemsSource="{Binding LegacyChoices}"
                            IsVisible="{Binding IsLegacyMode}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileModLegacyChoiceViewModel">
                    <ListBoxItem Theme="{StaticResource ViewModelSelectableListBoxItemTheme}" Classes="option-choice-item"
                                 Tapped="LegacyChoice_Tapped">
                      <Border Classes="sub-choice">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </Border>
                    </ListBoxItem>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
</UserControl>
