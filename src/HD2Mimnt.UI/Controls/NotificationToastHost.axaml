<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.Controls"
             xmlns:services="using:HD2Mimnt.Application.Services"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Controls.NotificationToastHost"
             x:DataType="vm:NotificationPanelViewModel">
  <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
  <ItemsControl ItemsSource="{Binding Toasts}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="services:Notification">
        <Border Classes="notification-card notification-toast" Margin="0,0,0,12"
                PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Classes="notification-icon" VerticalAlignment="Top">
              <controls:UtilityIcon Kind="Bell" Width="20" Height="20"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" Margin="12,0,4,0">
              <TextBlock Text="DarktideMimnt" Classes="caption-text"/>
              <TextBlock Text="{loc:LocalizedBinding Title, TargetNullValue=通知}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:LocalizedBinding Message}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" ToolTip.Tip="{loc:LocalizedBinding Message}"/>
              <TextBlock Text="{loc:LocalizedBinding Level, InnerConverter={StaticResource NotificationLevelLabelConverter}}" Classes="caption-text"
                         Classes.success="{Binding Level, Converter={StaticResource EqualConverter}, ConverterParameter=Success}"
                         Classes.warning="{Binding Level, Converter={StaticResource EqualConverter}, ConverterParameter=Warning}"
                         Classes.error="{Binding Level, Converter={StaticResource EqualConverter}, ConverterParameter=Error}"/>
              <Button Content="{loc:LocalizedBinding ActionText, TargetNullValue=打开}" IsVisible="{Binding HasAction}"
                      Classes="tertiary" HorizontalAlignment="Left" Margin="-8,0,0,0"
                      Command="{Binding $parent[UserControl].((vm:NotificationPanelViewModel)DataContext).ExecuteActionCommand}"
                      CommandParameter="{Binding}"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="icon-button" VerticalAlignment="Top" ToolTip.Tip="{loc:Loc UI.DismissBannerAndKeepNotification}"
                    Command="{Binding $parent[UserControl].((vm:NotificationPanelViewModel)DataContext).DismissToastCommand}"
                    CommandParameter="{Binding}"><controls:UtilityIcon Kind="Close"/></Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  </ScrollViewer>
</UserControl>
