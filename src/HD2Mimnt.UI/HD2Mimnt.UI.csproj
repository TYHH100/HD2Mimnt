<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ProductName>HD2Mimnt</ProductName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HD2Mimnt.Application\HD2Mimnt.Application.csproj" />
    <ProjectReference Include="..\HD2Mimnt.Cli\HD2Mimnt.Cli.csproj" />
    <ProjectReference Include="..\HD2Mimnt.Infrastructure\HD2Mimnt.Infrastructure.csproj" />
    <ProjectReference Include="..\HD2Mimnt.PluginHost\HD2Mimnt.PluginHost.csproj" />
    <ProjectReference Include="..\HD2Mimnt.Worker\HD2Mimnt.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\Monocraft.ttf" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\Monocraft.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 子进程入口（PluginHost/Worker/Cli）与主程序一样是普通多文件发布：项目引用已把各自的
       exe/dll/deps/runtimeconfig 带进发布列表，入口 dll 留在根目录，其余托管依赖统一进 lib/。
       四个入口程序集各自编译共享的 LibAssemblyResolver，从 lib/ 解析依赖。 -->
  <ItemGroup>
    <Compile Include="..\Shared\LibAssemblyResolver.cs" Link="LibAssemblyResolver.cs" />
  </ItemGroup>

  <!-- 不单文件发布：托管程序集与 pdb 统一收进 lib/，根目录只留入口 exe 及其 deps/runtimeconfig、
       原生库和内容目录；四个入口程序集的解析由共享 LibAssemblyResolver 在模块初始化阶段完成。
       原生库不能挪：DllImport 默认只在应用目录（及 deps 记录的原生搜索目录）里找。
       入口程序集（UI/Cli/PluginHost/Worker 的 dll）必须与各自 exe 同目录（宿主按 exe 名推导入口）。 -->
  <Target Name="MoveManagedAssembliesToLib" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <!-- 只收拢根目录顶层的托管 dll；zh-CN/ 之类的卫星资源目录保持原位，
           与 deps.json 记录的相对路径一致，避免额外的资源探测逻辑。 -->
      <_ManagedAssemblyToMove Include="@(ResolvedFileToPublish)"
                              Condition="'%(Extension)' == '.dll'
                                         and '%(RelativePath)' == '%(Filename)%(Extension)'
                                         and '%(ResolvedFileToPublish.AssetType)' != 'native'
                                         and '%(ResolvedFileToPublish.CopyToPublishDirectory)' != 'Never'
                                         and '%(Filename)' != 'HD2Mimnt.UI'
                                         and '%(Filename)' != 'HD2Mimnt.Cli'
                                         and '%(Filename)' != 'HD2Mimnt.PluginHost'
                                         and '%(Filename)' != 'HD2Mimnt.Worker'" />
      <_PublishRootPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)lib" />
    <Move SourceFiles="@(_ManagedAssemblyToMove->'$(PublishDir)%(RelativePath)')"
          DestinationFiles="@(_ManagedAssemblyToMove->'$(PublishDir)lib\%(RelativePath)')" />
    <Move SourceFiles="@(_PublishRootPdb)" DestinationFolder="$(PublishDir)lib"
          Condition="'@(_PublishRootPdb)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HD2Mimnt.UITests" />
  </ItemGroup>
</Project>
