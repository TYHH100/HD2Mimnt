<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels"
        xmlns:views="using:HD2Mimnt.UI.Views"
        xmlns:controls="using:HD2Mimnt.UI.Controls"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="HD2Mimnt.UI.MainWindow" x:DataType="vm:MainWindowViewModel"
        Closing="OnClosing" Title="{loc:LocalizedBinding Title}"
        Width="1280" Height="800" MinWidth="960" MinHeight="600">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToProfilesCommand}"/>
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToLibraryCommand}"/>
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToConflictsCommand}"/>
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateToToolsCommand}"/>
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateToSettingsCommand}"/>
    <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateToBrowseCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}"/>
  </Window.KeyBindings>
  <Grid>
  <Grid x:Name="ApplicationSurface" RowDefinitions="*,Auto" Background="Transparent" IsHitTestVisible="{Binding !Tutorial.IsOpen}">
    <Image Grid.RowSpan="2" Source="{Binding BackgroundImage}" Stretch="UniformToFill"
           Opacity="{Binding BackgroundImageOpacity}" IsHitTestVisible="False" IsVisible="{Binding HasBackgroundImage}">
      <Image.Effect><BlurEffect Radius="{Binding BackgroundBlurRadius}"/></Image.Effect>
    </Image>
    <fa:FANavigationView x:Name="NavigationView" PaneDisplayMode="Top" PaneTitle="HD2Mimnt"
                         IsBackButtonVisible="False" IsPaneToggleButtonVisible="False"
                         IsSettingsVisible="False" AlwaysShowHeader="False"
                         Background="Transparent"
                         SelectionChanged="OnNavigationSelectionChanged">
      <fa:FANavigationView.Resources>
        <!-- 复用可调透明度的画刷，避免导航容器在背景图上额外铺一层不透明底色。 -->
        <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="ChromeFillBrush"/>
        <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="ContentFillBrush"/>
      </fa:FANavigationView.Resources>
      <fa:FANavigationView.MenuItems>
        <fa:FANavigationViewItem Content="{loc:Loc UI.Profiles}" IconSource="Folder" Tag="0" IsVisible="{Binding SettingsViewModel.ShowProfilesEntry}"/>
        <fa:FANavigationViewItem Content="{loc:Loc UI.Library}" IconSource="Library" Tag="1" IsVisible="{Binding SettingsViewModel.ShowLibraryEntry}"/>
        <fa:FANavigationViewItem Content="{loc:Loc Browse.Title}" IconSource="Globe" Tag="5" IsVisible="{Binding SettingsViewModel.ShowBrowseEntry}"/>
        <fa:FANavigationViewItem Content="{loc:Loc UI.Conflicts}" IconSource="Important" Tag="2" IsVisible="{Binding SettingsViewModel.ShowConflictsEntry}"/>
        <fa:FANavigationViewItem Content="{loc:Loc UI.Tools}" IconSource="Repair" Tag="3" IsVisible="{Binding SettingsViewModel.ShowToolsEntry}"/>
        <fa:FANavigationViewItem Content="{loc:Loc Settings.Title}" IconSource="Settings" Tag="4"/>
      </fa:FANavigationView.MenuItems>
      <fa:FANavigationView.PaneFooter>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,16,0">
          <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{loc:LocalizedBinding GameStatus}">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource DisabledBrush}" Classes.detected="{Binding GameDetected}" VerticalAlignment="Center">
              <Ellipse.Styles><Style Selector="Ellipse.detected"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></Style></Ellipse.Styles>
            </Ellipse>
            <TextBlock Text="{loc:LocalizedBinding GameStatus}" Classes="caption-text" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Grid>
            <Button x:Name="TaskCenterButton" Command="{Binding OpenTaskCenterCommand}" Classes="icon-button" ToolTip.Tip="{loc:Loc UI.OpenTaskCenter}"><controls:UtilityIcon Kind="Tasks"/></Button>
            <fa:FAInfoBadge Value="{Binding RunningTaskCount}" IsVisible="{Binding RunningTaskCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"/>
          </Grid>
          <Grid>
            <Button x:Name="NotificationsButton" Command="{Binding OpenNotificationsCommand}" Classes="icon-button" ToolTip.Tip="{loc:Loc UI.OpenNotifications}"><controls:UtilityIcon Kind="Bell"/></Button>
            <fa:FAInfoBadge Value="{Binding UnreadNotificationCount}" IsVisible="{Binding UnreadNotificationCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"/>
          </Grid>
        </StackPanel>
      </fa:FANavigationView.PaneFooter>
      <Border Background="{DynamicResource ContentFillBrush}">
        <!-- 页面顺序与 ViewModel 的导航命令一致，保留各页面状态。 -->
        <TabControl x:Name="PageHost" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
          <TabControl.Styles><Style Selector="TabItem"><Setter Property="IsVisible" Value="False"/></Style></TabControl.Styles>
          <TabItem><views:ProfileView DataContext="{Binding ProfileViewModel}"/></TabItem>
          <TabItem><views:LibraryView DataContext="{Binding LibraryViewModel}"/></TabItem>
          <TabItem><views:ConflictsView DataContext="{Binding ConflictsViewModel}"/></TabItem>
          <TabItem><views:MoreView/></TabItem>
          <TabItem><views:SettingsView DataContext="{Binding SettingsViewModel}"/></TabItem>
          <TabItem><views:BrowseModsView DataContext="{Binding BrowseModsViewModel}"/></TabItem>
        </TabControl>
      </Border>
    </fa:FANavigationView>
    <Border Grid.Row="1" Background="{DynamicResource ChromeFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid Height="32" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{loc:LocalizedBinding StatusBarText}" Classes="caption-text"/>
          <TextBlock Text="·" Classes="caption-text"/>
          <TextBlock Text="{Binding CurrentProfileName}" Classes="caption-text"/>
          <TextBlock Text="{loc:LocalizedBinding DeploymentStatus}" Classes="caption-text"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="v0.1.0" Classes="caption-text" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <controls:NotificationToastHost x:Name="ToastHost" DataContext="{Binding NotificationPanelViewModel}"
                                    IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsNotificationPanelOpen}"
                                    Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,64,20,16" ZIndex="220"/>
    <Panel IsVisible="{Binding IsNotificationPanelOpen}" ZIndex="210">
      <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource NotificationCornerRadius}" BoxShadow="0 6 22 0 #26000000" ClipToBounds="True"
              Width="400" MaxHeight="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,64,16,16">
        <controls:NotificationPanel DataContext="{Binding NotificationPanelViewModel}"/>
      </Border>
    </Panel>
    <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsTaskCenterOpen}" ZIndex="200">
      <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource OverlayCornerRadius}"
              MaxWidth="680" MaxHeight="560" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <Button Command="{Binding CloseTaskCenterCommand}" Classes="icon-button" HorizontalAlignment="Right" ToolTip.Tip="{loc:Loc Common.Close}"><controls:UtilityIcon Kind="Close"/></Button>
          <views:TaskCenterView Grid.Row="1" DataContext="{Binding TaskCenterViewModel}"/>
        </Grid>
      </Border>
    </Border>
    <controls:ImagePreviewOverlay Grid.RowSpan="2" DataContext="{Binding ImagePreview}" ZIndex="300"/>
    <controls:ModImportOverlay x:Name="ModImportOverlay" Grid.RowSpan="2" DataContext="{Binding LibraryViewModel}" ZIndex="350"/>
    <Border x:Name="ImportDragHint" Grid.RowSpan="2" Background="{DynamicResource OverlayScrimBrush}"
            IsHitTestVisible="False" IsVisible="False" ZIndex="400">
      <Border Classes="card" Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
        <StackPanel Spacing="8">
          <controls:UtilityIcon Kind="Add" Width="28" Height="28" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="{loc:Loc UI.ReleaseToImportMods}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{loc:Loc UI.DropAnywhereInTheWindowToImportMultipleMods}" Classes="caption-text" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
    <controls:TutorialOverlay x:Name="TutorialGuide" DataContext="{Binding Tutorial}" Source="{Binding #ApplicationSurface}" ZIndex="500"/>
  </Grid>
</Window>
