<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:HD2Mimnt.UI.ViewModels" xmlns:views="using:HD2Mimnt.UI.Views" xmlns:controls="using:HD2Mimnt.UI.Controls" mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800" x:Class="HD2Mimnt.UI.MainWindow" Closing="OnClosing" x:DataType="vm:MainWindowViewModel" Title="{Binding Title}" Width="1280" Height="800" MinWidth="960" MinHeight="600" Background="{DynamicResource Surface0Brush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToProfilesCommand}"/><KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToLibraryCommand}"/><KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToSettingsCommand}"/><KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateToMoreCommand}"/><KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}"/>
  </Window.KeyBindings>
  <Design.DataContext><vm:MainWindowViewModel/></Design.DataContext>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="52">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Width="26" Height="26" Background="{DynamicResource AccentBrush}" CornerRadius="2"><TextBlock Text="M" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Surface0Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="HD2Mimnt" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="32,0,0,0" VerticalAlignment="Stretch">
          <RadioButton Content="配置文件" Command="{Binding NavigateToProfilesCommand}" GroupName="Navigation" Classes="nav-button" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=0}"/><RadioButton Content="模组库" Command="{Binding NavigateToLibraryCommand}" GroupName="Navigation" Classes="nav-button" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=1}"/><RadioButton Content="设置" Command="{Binding NavigateToSettingsCommand}" GroupName="Navigation" Classes="nav-button" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=2}"/><RadioButton Content="更多" Command="{Binding NavigateToMoreCommand}" GroupName="Navigation" Classes="nav-button" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=3}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{Binding GameDetected, Converter={StaticResource BoolToColorConverter}}" VerticalAlignment="Center"/><TextBlock Text="{Binding GameStatus}" Classes="caption-text" VerticalAlignment="Center"/></StackPanel>
          <Grid><Button Command="{Binding OpenTaskCenterCommand}" Classes="icon-button" ToolTip.Tip="打开任务中心"><controls:UtilityIcon Kind="Tasks"/></Button><Border Classes="badge" IsVisible="{Binding RunningTaskCount, Converter={StaticResource GreaterThanZeroConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"><TextBlock Text="{Binding RunningTaskCount}"/></Border></Grid>
          <Grid><Button Command="{Binding OpenNotificationsCommand}" Classes="icon-button" ToolTip.Tip="打开通知"><controls:UtilityIcon Kind="Bell"/></Button><Border Classes="badge" IsVisible="{Binding UnreadNotificationCount, Converter={StaticResource GreaterThanZeroConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"><TextBlock Text="{Binding UnreadNotificationCount}"/></Border></Grid>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}"><TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0"><TabControl.Styles><Style Selector="TabItem"><Setter Property="IsVisible" Value="False"/></Style></TabControl.Styles><TabItem><views:ProfileView DataContext="{Binding ProfileViewModel}"/></TabItem><TabItem><views:LibraryView DataContext="{Binding LibraryViewModel}"/></TabItem><TabItem><views:SettingsView DataContext="{Binding SettingsViewModel}"/></TabItem><TabItem><views:MoreView/></TabItem></TabControl></Border>
    <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0"><Grid Height="28" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding StatusBarText}" Classes="caption-text"/><TextBlock Text="·" Classes="caption-text"/><TextBlock Text="{Binding CurrentProfileName}" Classes="caption-text"/><TextBlock Text="{Binding DeploymentStatus}" Classes="caption-text"/></StackPanel><TextBlock Grid.Column="1" Text="v0.1.0" Classes="caption-text" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Row="1" Background="#66000000" IsVisible="{Binding IsNotificationPanelOpen}" ZIndex="210"><Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Width="400" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"><controls:NotificationPanel DataContext="{Binding NotificationPanelViewModel}"/></Border></Border>
    <Border Grid.Row="1" Background="#66000000" IsVisible="{Binding IsTaskCenterOpen}" ZIndex="200"><Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Width="680" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16"><Grid RowDefinitions="Auto,*"><Button Content="关闭" Command="{Binding CloseTaskCenterCommand}" Classes="tertiary" HorizontalAlignment="Right"/><views:TaskCenterView Grid.Row="1" DataContext="{Binding TaskCenterViewModel}"/></Grid></Border></Border>
  </Grid>
</Window>
