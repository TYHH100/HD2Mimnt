<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels"
        xmlns:views="using:HD2Mimnt.UI.Views"
        xmlns:controls="using:HD2Mimnt.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="HD2Mimnt.UI.MainWindow"
        Closing="OnClosing"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource Surface1Brush}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToLibraryCommand}" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToProfilesCommand}" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateToMoreCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}" />
    </Window.KeyBindings>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Title -->
                <TextBlock Grid.Column="0"
                          Text="HD2Mimnt"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"/>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <RadioButton Content="Library"
                                Command="{Binding NavigateToLibraryCommand}"
                                GroupName="Navigation"
                                Classes="nav-button"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=0}"/>
                    <RadioButton Content="Profiles"
                                Command="{Binding NavigateToProfilesCommand}"
                                GroupName="Navigation"
                                Classes="nav-button"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=1}"/>
                    <RadioButton Content="Settings"
                                Command="{Binding NavigateToSettingsCommand}"
                                GroupName="Navigation"
                                Classes="nav-button"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=2}"/>
                    <RadioButton Content="More"
                                Command="{Binding NavigateToMoreCommand}"
                                GroupName="Navigation"
                                Classes="nav-button"
                                IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualConverter}, ConverterParameter=3}"/>
                </StackPanel>

                <!-- Right Side Actions -->
                <StackPanel Grid.Column="2"
                           Orientation="Horizontal"
                           Spacing="12"
                           VerticalAlignment="Center">
                    <!-- Game Status -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8"
                                Fill="{Binding GameDetected, Converter={StaticResource BoolToColorConverter}}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GameStatus}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Task Center Icon -->
                    <Grid>
                        <Button Command="{Binding OpenTaskCenterCommand}"
                               Classes="icon-button"
                               ToolTip.Tip="Task Center">
                            <TextBlock Text="⚙" FontSize="16"/>
                        </Button>
                        <Border Classes="badge"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-4,-4,0"
                               IsVisible="{Binding RunningTaskCount, Converter={StaticResource GreaterThanZeroConverter}}">
                            <TextBlock Text="{Binding RunningTaskCount}"/>
                        </Border>
                    </Grid>

                    <!-- Notification Icon -->
                    <Grid>
                        <Button Command="{Binding OpenNotificationsCommand}"
                               Classes="icon-button"
                               ToolTip.Tip="Notifications">
                            <TextBlock Text="🔔" FontSize="16"/>
                        </Button>
                        <Border Classes="badge"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-4,-4,0"
                               IsVisible="{Binding UnreadNotificationCount, Converter={StaticResource GreaterThanZeroConverter}}">
                            <TextBlock Text="{Binding UnreadNotificationCount}"/>
                        </Border>
                    </Grid>

                    <!-- Dev Tools Button -->
                    <Button Command="{Binding OpenDevToolsCommand}"
                           Classes="icon-button"
                           ToolTip.Tip="开发工具">
                        <TextBlock Text="🛠" FontSize="16"/>
                    </Button>

                    <TextBlock Text="v0.1.0"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                       Background="Transparent"
                       BorderThickness="0">
                <TabControl.Styles>
                    <Style Selector="TabControl">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="TabItem">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>

                <!-- Library Tab -->
                <TabItem>
                    <views:LibraryView DataContext="{Binding LibraryViewModel}"/>
                </TabItem>

                <!-- Profiles Tab -->
                <TabItem>
                    <views:ProfileView DataContext="{Binding ProfileViewModel}"/>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem>
                    <views:SettingsView DataContext="{Binding SettingsViewModel}"/>
                </TabItem>

                <!-- More Tab -->
                <TabItem>
                    <views:MoreView/>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Left: Current Profile -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Profile:"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentProfileName}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12"
                              FontWeight="Medium"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Deployment Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Ellipse Classes="status-indicator"
                            Fill="{Binding IsDeployed, Converter={StaticResource BoolToColorConverter}}"/>
                    <TextBlock Text="{Binding DeploymentStatus}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Task Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="Tasks:"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TaskStatusText}"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#CC05070C" IsVisible="{Binding IsNotificationPanelOpen}" ZIndex="210">
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Width="460" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="通知" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/><Button Grid.Column="1" Content="关闭" Command="{Binding CloseNotificationsCommand}" Classes="secondary"/></Grid>
                    <controls:NotificationPanel Grid.Row="1" DataContext="{Binding NotificationPanelViewModel}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Border>
        <Border Grid.Row="1" Background="#CC05070C" IsVisible="{Binding IsTaskCenterOpen}" ZIndex="200">
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Width="760" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                <Grid RowDefinitions="Auto,*"><Button Content="关闭" Command="{Binding CloseTaskCenterCommand}" HorizontalAlignment="Right" Classes="secondary"/><views:TaskCenterView Grid.Row="1" DataContext="{Binding TaskCenterViewModel}"/></Grid>
            </Border>
        </Border>
    </Grid>
</Window>

