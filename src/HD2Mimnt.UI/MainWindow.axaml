<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="HD2Mimnt.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#0A0D12">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#0F131C" BorderBrush="#1E2636" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Title -->
                <TextBlock Grid.Column="0"
                          Text="HD2Mimnt"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="#E0E0E0"
                          VerticalAlignment="Center"/>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button Content="Library"
                           Command="{Binding NavigateToLibraryCommand}"
                           Classes="nav-button"
                           IsDefault="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                    <Button Content="Profiles"
                           Command="{Binding NavigateToProfilesCommand}"
                           Classes="nav-button"/>
                    <Button Content="Tasks"
                           Command="{Binding NavigateToTasksCommand}"
                           Classes="nav-button"/>
                    <Button Content="Settings"
                           Command="{Binding NavigateToSettingsCommand}"
                           Classes="nav-button"/>
                </StackPanel>

                <!-- Right Side Actions -->
                <StackPanel Grid.Column="2"
                           Orientation="Horizontal"
                           Spacing="8"
                           VerticalAlignment="Center">
                    <TextBlock Text="v0.1.0"
                              Foreground="#6B7280"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Background="#05070C">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                       Background="Transparent"
                       BorderThickness="0">
                <TabControl.Styles>
                    <Style Selector="TabControl">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="TabItem">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>

                <!-- Library Tab -->
                <TabItem>
                    <Border Padding="24">
                        <TextBlock Text="Mod Library - Coming Soon"
                                  FontSize="24"
                                  Foreground="#9CA3AF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </TabItem>

                <!-- Profiles Tab -->
                <TabItem>
                    <Border Padding="24">
                        <TextBlock Text="Profiles - Coming Soon"
                                  FontSize="24"
                                  Foreground="#9CA3AF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </TabItem>

                <!-- Tasks Tab -->
                <TabItem>
                    <Border Padding="24">
                        <TextBlock Text="Task Center - Coming Soon"
                                  FontSize="24"
                                  Foreground="#9CA3AF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem>
                    <Border Padding="24">
                        <TextBlock Text="Settings - Coming Soon"
                                  FontSize="24"
                                  Foreground="#9CA3AF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>

