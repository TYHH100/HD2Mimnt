<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 基础控件的模板、禁用/悬停/按下/焦点状态由 FluentAvalonia 提供。 -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"/>
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
    <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  </Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="32"/></Style>
  <Style Selector="Button.tertiary, Button.icon-button, Button.side-nav, Button.tool-row">
    <Setter Property="Theme" Value="{DynamicResource TransparentButton}"/>
  </Style>
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6"/>
  </Style>
  <Style Selector="Border.notification-card">
    <Setter Property="Background" Value="{DynamicResource NotificationSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NotificationCornerRadius}"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BoxShadow" Value="0 6 22 0 #26000000"/>
  </Style>
  <Style Selector="Border.notification-icon">
    <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Border.notification-toast">
    <Setter Property="RenderTransform"><TranslateTransform X="0"/></Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.X" Value="32"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.X" Value="0"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
  </Style>
  <Style Selector="Button.danger:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
  </Style>
  <Style Selector="TextBlock.muted, TextBlock.secondary-text"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <Style Selector="TextBlock.accent-text"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Style>
  <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.body-text"><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/></Style>
  <Style Selector="TextBlock.secondary-text"><Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/></Style>
  <Style Selector="TextBlock.caption-text, TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
  </Style>
  <Style Selector="Border.card, Border.mod-card, Border.option-card, Border.sub-choice">
    <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/><Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Border.mod-card"><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style Selector="Border.mod-card.compact"><Setter Property="Padding" Value="14,6"/></Style>
  <Style Selector="Border.mod-card:pointerover, Border.sub-choice:pointerover"><Setter Property="Background" Value="{DynamicResource Surface3Brush}"/></Style>
  <!-- 配置页分隔符分组的连贯半透明色板：铺在成员卡片底层，透明度跟随外观设置的卡片不透明度。 -->
  <Style Selector="Border.group-slab.is-group">
    <Setter Property="Background" Value="{DynamicResource GroupTintFallbackBrush}"/>
    <Setter Property="Opacity" Value="{DynamicResource CardSurfaceOpacity}"/>
  </Style>
  <Style Selector="Border.group-slab.is-group.custom-tint">
    <Setter Property="Background" Value="{ReflectionBinding GroupTintBrush}"/>
  </Style>
  <Style Selector="Border.group-slab.is-group.slab-start">
    <Setter Property="CornerRadius" Value="8,8,0,0"/>
  </Style>
  <Style Selector="Border.group-slab.is-group.slab-end">
    <Setter Property="CornerRadius" Value="0,0,8,8"/>
  </Style>
  <Style Selector="Border.group-slab.is-group.slab-start.slab-end">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.group-member-host.is-group">
    <Setter Property="Padding" Value="10,0"/>
  </Style>
  <Style Selector="Border.option-card"><Setter Property="Padding" Value="12,10"/></Style>
  <Style Selector="Border.sub-choice"><Setter Property="Padding" Value="10,8"/></Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/><Setter Property="Padding" Value="8,2"/>
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/><Setter Property="Padding" Value="8,2"/>
    <Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="StackPanel.section"><Setter Property="Margin" Value="0,0,0,20"/></Style>
  <Style Selector="Border.section"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,16"/></Style>
  <Style Selector="Button.side-nav, Button.tool-row">
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style Selector="TextBlock.caption-text.success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Style>
  <Style Selector="TextBlock.caption-text.warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
  <Style Selector="TextBlock.caption-text.error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></Style>
</Styles>
