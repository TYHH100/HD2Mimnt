<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels" xmlns:diag="using:HD2Mimnt.Core.Diagnostics"
             xmlns:loc="using:HD2Mimnt.UI.Localization" x:Class="HD2Mimnt.UI.Views.CrashDiagnosticsView"
             x:DataType="vm:CrashDiagnosticsViewModel">
  <StackPanel Spacing="14" Classes="section">
    <TextBlock Text="{loc:Loc Crash.Title}" Classes="section-title" />
    <TextBlock Text="{loc:Loc Crash.Description}" Classes="muted" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc Crash.ToolMissing}" IsVisible="{Binding !ToolAvailable}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="CrashDumpPathInput" Text="{Binding DumpPath}" Watermark="{loc:Loc Crash.Path}" IsEnabled="{Binding CanEdit}" />
      <Button Grid.Column="1" Content="{loc:Loc Crash.Browse}" Click="OnBrowseClicked" IsEnabled="{Binding CanEdit}" />
    </Grid>
    <ComboBox x:Name="CrashDumpList" ItemsSource="{Binding Dumps}" SelectedItem="{Binding SelectedDump}"
              HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" PlaceholderText="{loc:Loc Crash.RecentDumps}">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="diag:CrashDumpFile"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <WrapPanel Orientation="Horizontal">
      <Button Content="{loc:Loc Crash.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
      <Button x:Name="AnalyzeCrashButton" Content="{loc:Loc Crash.Analyze}" Command="{Binding AnalyzeCommand}" Classes="accent" Margin="0,0,8,8" />
      <Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,8,8" />
      <Button x:Name="ExportCrashReportButton" Content="{loc:Loc Crash.Export}" Click="OnExportClicked" IsVisible="{Binding HasReport}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8" />
    </WrapPanel>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <TextBlock x:Name="CrashStatusText" Text="{loc:LocalizedBinding StatusMessage}" TextWrapping="Wrap" Classes="muted" />
    <Border Classes="card" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc Crash.History}" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc Crash.HistoryHelp}" TextWrapping="Wrap" Classes="muted" />
        <ComboBox x:Name="CrashHistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="diag:CrashDeploymentSnapshot"><StackPanel><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{loc:Loc Crash.KnownGood}" IsVisible="{Binding KnownGood}" Classes="muted"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="MarkCrashBaselineButton" Content="{loc:Loc Crash.MarkGood}" Command="{Binding MarkKnownGoodCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <StackPanel IsVisible="{Binding HasReport}" Spacing="12">
      <Border Classes="card" Padding="16"><StackPanel Spacing="8">
        <TextBlock x:Name="CrashSummaryText" Text="{Binding Summary}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CrashDetails}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ContextWarning}" TextWrapping="Wrap" Classes="muted" />
      </StackPanel></Border>
      <TextBlock Text="{loc:Loc Crash.ChangesTitle}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ComparisonDetails}" TextWrapping="Wrap" Classes="muted" />
      <ItemsControl ItemsSource="{Binding ChangeLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{loc:Loc Crash.NoChanges}" IsVisible="{Binding HasNoChanges}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{loc:Loc Crash.CluesTitle}" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding ClueLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{loc:Loc Crash.NoClues}" IsVisible="{Binding HasNoClues}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Text="{loc:Loc Crash.NextSteps}" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Loc Crash.Steps}" TextWrapping="Wrap" Classes="muted" />
      <Expander Header="{loc:Loc Crash.Stack}"><ItemsControl ItemsSource="{Binding FrameLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" FontFamily="Consolas" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
      <Expander Header="{loc:Loc Crash.Modules}"><TextBox Text="{Binding ModulesText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="220" FontFamily="Consolas" /></Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
