<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:HD2Mimnt.UI.Localization"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels.Darktide"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:avConverters="using:Avalonia.Data.Converters"
             x:Class="HD2Mimnt.UI.Views.DarktideLibraryView" x:DataType="vm:DarktideLibraryViewModel">
  <UserControl.DataTemplates>
          <DataTemplate x:DataType="vm:DarktideSeparatorRowViewModel">
            <Border Padding="12,8" Margin="0,8,0,4" Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,1">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Panel Width="6">
                  <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                  <Border Background="{Binding TintBrush}" IsVisible="{Binding HasCustomColor}" CornerRadius="3"/>
                </Panel>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Button Classes="icon-button" ToolTip.Tip="{loc:Loc UI.CollapseExpandGroup}"
                          Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).ToggleGroupCollapseCommand}"
                          CommandParameter="{Binding}">
                    <controls:UtilityIcon Kind="Chevron" RenderTransformOrigin="50%,50%">
                      <controls:UtilityIcon.RenderTransform><RotateTransform Angle="{Binding ChevronAngle}"/></controls:UtilityIcon.RenderTransform>
                    </controls:UtilityIcon>
                  </Button>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}"/>
                    <TextBlock Text="{Binding MemberSummary}" Classes="caption-text" VerticalAlignment="Center"
                               IsVisible="{Binding HasMembers}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon-button" ToolTip.Tip="{loc:Loc UI.GroupActions}">
                    <Button.Flyout>
                      <fa:FAMenuFlyout>
                        <fa:FAMenuFlyoutItem Text="{loc:Loc UI.Rename}"
                                             Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).EditGroupCommand}"
                                             CommandParameter="{Binding}"/>
                        <!-- 新建分组的入口暂时隐藏，已有分组仍可改名、折叠和删除。 -->
                        <fa:FAMenuFlyoutItem Text="{loc:Loc Darktide.Library.AddGroupAbove}" IsVisible="False"
                                             Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).AddGroupAboveCommand}"
                                             CommandParameter="{Binding}"/>
                        <fa:FAMenuFlyoutItem Text="{loc:Loc Darktide.Library.AddGroupBelow}" IsVisible="False"
                                             Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).AddGroupBelowCommand}"
                                             CommandParameter="{Binding}"/>
                        <fa:FAMenuFlyoutSeparator/>
                        <fa:FAMenuFlyoutItem Text="{loc:Loc Common.Delete}"
                                             Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).RemoveGroupCommand}"
                                             CommandParameter="{Binding}"/>
                      </fa:FAMenuFlyout>
                    </Button.Flyout>
                    <controls:UtilityIcon Kind="More"/>
                  </Button>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate x:DataType="vm:DarktideModItemViewModel">
            <Grid>
              <Border Classes="group-slab" Classes.is-group="{Binding IsInsideGroup}"
                      Classes.custom-tint="{Binding GroupTintBrush, Converter={x:Static avConverters:ObjectConverters.IsNotNull}}"
                      Classes.slab-start="{Binding IsSlabStart}" Classes.slab-end="{Binding IsSlabEnd}"/>
              <Border Classes="group-member-host" Classes.is-group="{Binding IsInsideGroup}">
                <Border Classes="mod-card" ToolTip.Tip="{Binding Description}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding InternalName}" FontSize="12" Classes="muted"/>
                        <TextBlock Text="·" FontSize="12" Classes="muted"/>
                        <TextBlock Text="{Binding Version}" FontSize="12" Classes="muted"/>
                        <TextBlock Text="·" FontSize="12" Classes="muted"/>
                        <TextBlock Text="{Binding Author}" FontSize="12" Classes="muted" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Author}"/>
                        <TextBlock Text="·" FontSize="12" Classes="muted" IsVisible="{Binding HasArchive}"/>
                        <TextBlock Text="{Binding ArchiveSizeText}" FontSize="12" Classes="caption-text" IsVisible="{Binding HasArchive}"/>
                        <TextBlock Text="{loc:Loc Darktide.Library.Disabled}" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding IsRegisteredOff}" Classes="muted"/>
                        <TextBlock Text="{loc:Loc Darktide.Library.InLibrary}" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding CanInstall}" Classes="muted"/>
                        <TextBlock Text="{loc:Loc Darktide.Library.Missing}" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding IsMissing}" Foreground="{DynamicResource ErrorBrush}"/>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding Diagnostics}" IsVisible="{Binding HasIssues}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DarktideDiagnosticItemViewModel">
                            <TextBlock Text="{Binding Title}" Classes="caption-text" Classes.error="{Binding IsError}"
                                       Classes.warning="{Binding IsWarning}" TextWrapping="Wrap"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <!-- 启停改用开关：登记/取消登记是二元状态，两个互斥文字按钮读起来反而更绕。 -->
                      <ToggleSwitch IsChecked="{Binding Registered, Mode=OneWay}" OnContent="" OffContent=""
                                    Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).ToggleCommand}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Loc Darktide.Library.ToggleHint}"/>
                      <Button Content="{loc:Loc Darktide.Library.Install}" Classes="accent" IsVisible="{Binding CanInstall}"
                              Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).InstallCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Content="{loc:Loc Darktide.Library.Update}" Classes="secondary" IsVisible="{Binding CanReinstall}"
                              Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).InstallCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Content="{loc:Loc Darktide.Library.Uninstall}" Classes="danger" IsVisible="{Binding CanUninstall}"
                              Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).UninstallCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Classes="icon-button" IsVisible="{Binding CanOpenFolder}" ToolTip.Tip="{loc:Loc Darktide.Library.OpenFolder}"
                              Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).OpenFolderCommand}"
                              CommandParameter="{Binding}">
                        <controls:UtilityIcon Kind="Folder"/>
                      </Button>
                      <Button Classes="icon-button" IsVisible="{Binding CanRemoveLibrary}" ToolTip.Tip="{loc:Loc Darktide.Library.RemoveFromLibrary}"
                              Command="{Binding $parent[UserControl].((vm:DarktideLibraryViewModel)DataContext).RemoveLibraryCommand}"
                              CommandParameter="{Binding}">
                        <controls:UtilityIcon Kind="Close" Foreground="{DynamicResource ErrorBrush}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </Border>
            </Grid>
          </DataTemplate>  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,18,24,12" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{loc:Loc Darktide.Library.Title}" Classes="page-title"/>
        <TextBlock Text="{loc:Loc Darktide.Library.Subtitle}" Classes="page-subtitle"/>
        <TextBlock Text="{Binding SummaryText}" Classes="caption-text"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <CheckBox Content="{loc:Loc Darktide.Library.RegisterAfterImport}" IsChecked="{Binding RegisterAfterImport}"
                  VerticalAlignment="Center"/>
        <!-- 分组入口暂时隐藏：功能与数据保留，恢复时去掉 IsVisible 即可。 -->
        <Button Content="{loc:Loc UI.AddGroupSeparator}" Command="{Binding AddGroupCommand}" Classes="secondary"
                ToolTip.Tip="{loc:Loc UI.AddGroupSeparator}" IsVisible="False"/>
        <Button Content="{loc:Loc Darktide.Library.Import}" Command="{Binding ImportCommand}" Classes="accent"
                IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{loc:Loc Darktide.Common.Refresh}" Command="{Binding RefreshCommand}" Classes="secondary"
                IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{loc:Loc Darktide.Common.Cancel}" Command="{Binding CancelOperationCommand}" Classes="tertiary"
                IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" IsVisible="{Binding HasWarning}" Background="{DynamicResource WarningBackgroundBrush}"
            CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <controls:UtilityIcon Kind="Warning" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding WarningText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding HasProgress}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding ProgressText}" Classes="caption-text"/>
        <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Classes="caption-text"/>
      </Grid>
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="5"/>
    </StackPanel>
    <Grid Grid.Row="3">
      <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <!-- 卡片自带边框与内边距，容器不再叠加默认内缩，避免选中底色出现双重描边。 -->
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
        </ListBox.Styles>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <controls:UtilityIcon Kind="Package" Width="40" Height="40" Opacity="0.4" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Darktide.Library.Empty}" FontSize="18" FontWeight="SemiBold" Classes="muted" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc Darktide.Library.EmptyHint}" FontSize="13" Classes="caption-text" HorizontalAlignment="Center"/>
        <Button Content="{loc:Loc Darktide.Library.Import}" Command="{Binding ImportCommand}" Classes="accent" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- 分组编辑浮窗：名称与颜色共用一次提交，失败时保留输入。 -->
    <Border Grid.RowSpan="4" IsVisible="{Binding IsSeparatorDialogOpen}" Background="{DynamicResource OverlayScrimBrush}" ZIndex="25">
      <Border Classes="card" Background="{DynamicResource Surface2Brush}" Width="420" Padding="20"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding SeparatorTitle}" Classes="section-title"/>
          <TextBox Text="{Binding SeparatorName}" PlaceholderText="{loc:Loc UI.ForExampleWeaponsArmorInterface}"
                   IsReadOnly="{Binding !IsSeparatorNameEditable}"/>
          <CheckBox Content="{loc:Loc UI.UseThemeColor}" IsChecked="{Binding UseDefaultSeparatorColor}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{loc:Loc UI.GroupColor}" VerticalAlignment="Center"/>
            <ColorPicker Grid.Column="1" Color="{Binding SeparatorColor, Mode=TwoWay}" IsAlphaEnabled="False"
                         IsAlphaVisible="False" IsEnabled="{Binding !UseDefaultSeparatorColor}"/>
          </Grid>
          <TextBlock Text="{Binding SeparatorError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding SeparatorError, Converter={StaticResource NotNullConverter}}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelSeparatorDialogCommand}" Classes="tertiary"/>
            <Button Content="{loc:Loc Common.Save}" Command="{Binding ConfirmSeparatorCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
