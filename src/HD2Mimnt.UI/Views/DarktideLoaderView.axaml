<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:HD2Mimnt.UI.Localization"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels.Darktide"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Views.DarktideLoaderView" x:DataType="vm:DarktideLoaderViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24,18,24,12" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{loc:Loc Darktide.Loader.Title}" Classes="page-title"/>
        <TextBlock Text="{loc:Loc Darktide.Loader.Subtitle}" Classes="page-subtitle"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{loc:Loc Darktide.Loader.CheckUpdate}" Command="{Binding CheckUpdateCommand}" Classes="accent" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{loc:Loc Darktide.Loader.ReleasePage}" Command="{Binding OpenReleasePageCommand}" Classes="secondary"/>
        <Button Content="{loc:Loc Darktide.Common.Refresh}" Command="{Binding RefreshCommand}" Classes="tertiary" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="{loc:Loc Darktide.Common.Cancel}" Command="{Binding CancelOperationCommand}" Classes="tertiary" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc Darktide.Loader.Game}" Classes="section-title"/>
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Text="{loc:Loc Darktide.Loader.GamePath}" Classes="caption-text"/>
              <TextBlock Grid.Column="1" Text="{Binding GamePathText}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Text="{loc:Loc Darktide.Loader.Dml}" Classes="caption-text"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LoaderStatusText}" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="2" Text="{loc:Loc Darktide.Loader.Dmf}" Classes="caption-text"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DmfStatusText}"/>
              <TextBlock Grid.Row="3" Text="{loc:Loc Darktide.Loader.Patcher}" Classes="caption-text"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PatcherStatusText}"/>
              <TextBlock Grid.Row="4" Text="{loc:Loc Darktide.Loader.PatchState}" Classes="caption-text"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PatchStateText}" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningBrush}"/>
            </Grid>
            <Border IsVisible="{Binding DmfMissing}" Background="{DynamicResource WarningBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <controls:UtilityIcon Kind="Warning" VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="{loc:Loc Darktide.Loader.DmfMissingHint}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc Darktide.Loader.ImportDmf}" Command="{Binding ImportDmfCommand}"
                            Classes="secondary" IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="{loc:Loc Darktide.Loader.OpenDmfPage}" Command="{Binding OpenDmfPageCommand}"
                            Classes="tertiary"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border IsVisible="{Binding HasAlternative}" Background="{DynamicResource WarningBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <controls:UtilityIcon Kind="Warning" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding AlternativeText}" TextWrapping="Wrap"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc Darktide.Loader.Release}" Classes="section-title"/>
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Text="{loc:Loc Darktide.Loader.Latest}" Classes="caption-text"/>
              <TextBlock Grid.Column="1" Text="{Binding LatestVersion}" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="1" Text="{loc:Loc Darktide.Loader.Published}" Classes="caption-text"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestPublished}"/>
              <TextBlock Grid.Row="2" Text="{loc:Loc Darktide.Loader.AvailablePackages}" Classes="caption-text"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PackageSummary}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Text="{loc:Loc Darktide.Loader.InstalledRecord}" Classes="caption-text"/>
              <StackPanel Grid.Row="3" Grid.Column="1">
                <TextBlock Text="{Binding RecordedVersion}"/>
                <TextBlock Text="{Binding RecordedAt}" Classes="caption-text"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding AutoPackageText}" Classes="caption-text" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:Loc Darktide.Loader.InstallLatest}" Classes="accent" Command="{Binding InstallLatestCommand}"
                      IsEnabled="{Binding HasRelease}"/>
              <Button Content="{loc:Loc Darktide.Loader.InstallFull}" Classes="secondary" Command="{Binding InstallFullCommand}"
                      IsEnabled="{Binding CanInstallFull}"/>
              <Button Content="{loc:Loc Darktide.Loader.InstallUpdateOnly}" Classes="secondary" Command="{Binding InstallUpdateOnlyCommand}"
                      IsEnabled="{Binding CanInstallUpdateOnly}"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasProgress}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ProgressText}" Classes="caption-text"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Classes="caption-text"/>
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="5"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc Darktide.Loader.Toggle}" Classes="section-title"/>
            <TextBlock Text="{loc:Loc Darktide.Loader.ToggleHint}" Classes="caption-text" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource WarningBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <controls:UtilityIcon Kind="Warning" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Grid.Column="1" Text="{loc:Loc Darktide.Loader.ToggleWarning}" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <Button Content="{loc:Loc Darktide.Loader.RunToggle}" Classes="accent" Command="{Binding RunToggleCommand}"
                    HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
