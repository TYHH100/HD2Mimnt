<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels.Darktide"
        xmlns:views="using:HD2Mimnt.UI.Views"
        xmlns:controls="using:HD2Mimnt.UI.Controls"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="HD2Mimnt.UI.Views.DarktideMainWindow" x:DataType="vm:DarktideMainWindowViewModel"
        Title="{Binding Title}" Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        Closing="OnClosing">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateToLibraryCommand}"/>
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateToLoadOrderCommand}"/>
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateToProfilesCommand}"/>
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateToLoaderCommand}"/>
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateToSettingsCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}"/>
  </Window.KeyBindings>
  <Grid RowDefinitions="*,Auto">
    <!-- 背景图铺在最底层且不吃命中；内容区透明度由外观设置降到 0 时才露出来。 -->
    <Image Grid.RowSpan="2" Source="{Binding BackgroundImage}" Stretch="UniformToFill"
           Opacity="{Binding BackgroundImageOpacity}" IsHitTestVisible="False" IsVisible="{Binding HasBackgroundImage}">
      <Image.Effect><BlurEffect Radius="{Binding BackgroundBlurRadius}"/></Image.Effect>
    </Image>
    <fa:FANavigationView x:Name="NavigationView" PaneDisplayMode="Top" PaneTitle="DarktideMimnt"
                         IsBackButtonVisible="False" IsPaneToggleButtonVisible="False"
                         IsSettingsVisible="False" AlwaysShowHeader="False" Background="Transparent"
                         SelectionChanged="OnNavigationSelectionChanged">
      <fa:FANavigationView.Resources>
        <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="ChromeFillBrush"/>
        <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="ContentFillBrush"/>
      </fa:FANavigationView.Resources>
      <fa:FANavigationView.MenuItems>
        <fa:FANavigationViewItem Content="{loc:Loc Darktide.Nav.Library}" IconSource="Library" Tag="0"/>
        <fa:FANavigationViewItem Content="{loc:Loc Darktide.Nav.LoadOrder}" IconSource="Sort" Tag="1"/>
        <fa:FANavigationViewItem Content="{loc:Loc Darktide.Nav.Profiles}" IconSource="Folder" Tag="2"/>
        <fa:FANavigationViewItem Content="{loc:Loc Darktide.Nav.Loader}" IconSource="Repair" Tag="3"/>
        <fa:FANavigationViewItem Content="{loc:Loc Darktide.Nav.Settings}" IconSource="Settings" Tag="4"/>
      </fa:FANavigationView.MenuItems>
      <fa:FANavigationView.PaneFooter>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,16,0">
          <Button Command="{Binding LaunchGameCommand}" Classes="accent" IsEnabled="{Binding CanLaunchGame}"
                  ToolTip.Tip="{loc:Loc Darktide.Game.LaunchHint}" Width="36" MinWidth="0" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <controls:UtilityIcon Kind="Play" Width="16" Height="16"/>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding GamePathText}">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource DisabledBrush}" Classes.detected="{Binding GameDetected}" VerticalAlignment="Center">
              <Ellipse.Styles><Style Selector="Ellipse.detected"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></Style></Ellipse.Styles>
            </Ellipse>
            <TextBlock Text="{Binding GameStatusText}" Classes="caption-text" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Grid>
            <Button Command="{Binding OpenTaskCenterCommand}" Classes="icon-button" ToolTip.Tip="{loc:Loc UI.OpenTaskCenter}">
              <controls:UtilityIcon Kind="Tasks"/>
            </Button>
            <fa:FAInfoBadge Value="{Binding RunningTaskCount}" IsVisible="{Binding RunningTaskCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"/>
          </Grid>
          <Grid>
            <Button Command="{Binding OpenNotificationsCommand}" Classes="icon-button" ToolTip.Tip="{loc:Loc UI.OpenNotifications}">
              <controls:UtilityIcon Kind="Bell"/>
            </Button>
            <fa:FAInfoBadge Value="{Binding UnreadNotificationCount}" IsVisible="{Binding UnreadNotificationCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" IsHitTestVisible="False"/>
          </Grid>
        </StackPanel>
      </fa:FANavigationView.PaneFooter>
      <Border Background="{DynamicResource ContentFillBrush}">
        <TabControl x:Name="PageHost" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
          <TabControl.Styles><Style Selector="TabControl#PageHost > TabItem"><Setter Property="IsVisible" Value="False"/></Style></TabControl.Styles>
          <TabItem><views:DarktideLibraryView DataContext="{Binding Library}"/></TabItem>
          <TabItem><views:DarktideLoadOrderView DataContext="{Binding LoadOrder}"/></TabItem>
          <TabItem><views:DarktideProfilesView DataContext="{Binding Profiles}"/></TabItem>
          <TabItem><views:DarktideLoaderView DataContext="{Binding Loader}"/></TabItem>
          <TabItem><views:DarktideSettingsView DataContext="{Binding Settings}"/></TabItem>
        </TabControl>
      </Border>
    </fa:FANavigationView>
    <Border Grid.Row="1" Background="{DynamicResource ChromeFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid Height="30" ColumnDefinitions="*,Auto">
        <!-- 游戏状态与路径只在导航栏和状态栏各出现一次：导航栏给状态，状态栏给路径。 -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding TaskStatusText}" Classes="caption-text"/>
          <TextBlock Text="·" Classes="caption-text"/>
          <TextBlock Text="{Binding GamePathText}" Classes="caption-text" TextTrimming="CharacterEllipsis" MaxWidth="720"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="v0.1.0" Classes="caption-text" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <controls:NotificationToastHost DataContext="{Binding NotificationPanel}" Width="380"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,64,20,16" ZIndex="220"
                                    IsVisible="{Binding !$parent[Window].((vm:DarktideMainWindowViewModel)DataContext).IsNotificationPanelOpen}"/>
    <Panel IsVisible="{Binding IsNotificationPanelOpen}" ZIndex="210">
      <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource NotificationCornerRadius}" BoxShadow="0 6 22 0 #26000000" ClipToBounds="True"
              Width="400" MaxHeight="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,64,16,16">
        <controls:NotificationPanel DataContext="{Binding NotificationPanel}"/>
      </Border>
    </Panel>
    <Border Background="{DynamicResource OverlayScrimBrush}" IsVisible="{Binding IsTaskCenterOpen}" ZIndex="200">
      <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource OverlayCornerRadius}"
              MaxWidth="720" MaxHeight="580" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <Button Command="{Binding CloseTaskCenterCommand}" Classes="icon-button" HorizontalAlignment="Right" ToolTip.Tip="{loc:Loc Common.Close}">
            <controls:UtilityIcon Kind="Close"/>
          </Button>
          <views:TaskCenterView Grid.Row="1" DataContext="{Binding TaskCenter}"/>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
