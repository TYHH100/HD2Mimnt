<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="720"
        x:Class="HD2Mimnt.UI.Views.DevToolsWindow"
        x:DataType="vm:DevToolsViewModel"
        Title="开发工具"
        Width="600"
        Height="720"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface1Brush}">

    <Design.DataContext>
        <vm:DevToolsViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                  Text="开发工具"
                  FontSize="24"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Margin="0,0,0,24"/>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <TextBlock Text="N 网 API 密钥（测试）" Classes="section-title" />
                <TextBlock Text="密钥加密保存到本地数据库，启动时自动恢复。清除密钥会同时删除保存的数据。"
                           Classes="muted" TextWrapping="Wrap" />
                <TextBox x:Name="NexusApiKeyInput"
                         Text="{Binding NexusApiKey, Mode=TwoWay}"
                         IsEnabled="{Binding !IsSavingNexusKey}"
                         PasswordChar="●"
                         PlaceholderText="粘贴 Nexus Mods API 密钥" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ApplyNexusApiKeyButton" Content="保存并应用密钥"
                            Classes="accent" Command="{Binding ApplyNexusApiKeyCommand}" />
                    <Button x:Name="ClearNexusApiKeyButton" Content="清除密钥"
                            Command="{Binding ClearNexusApiKeyCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding NexusStatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Mod Count Input -->
        <Border Grid.Row="2"
               Background="Transparent"
               Padding="16"
               CornerRadius="0"
               Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                          Text="生成数量:"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <NumericUpDown Grid.Column="1"
                              Value="{Binding ModCount}"
                              Minimum="1"
                              Maximum="10000"
                              Increment="100"
                              FormatString="N0"
                              IsEnabled="{Binding !IsGenerating}"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Spacing="12">
            <Button Content="生成测试模组"
                   Command="{Binding GenerateTestModsCommand}"
                   IsEnabled="{Binding !IsGenerating}"
                   Classes="accent"
                   HorizontalAlignment="Stretch"
                   Padding="16,12"/>

            <Button Content="设置随机启用状态"
                   Command="{Binding GenerateEnabledStatesCommand}"
                   IsEnabled="{Binding !IsGenerating}"
                   Classes="secondary"
                   HorizontalAlignment="Stretch"
                   Padding="16,12"/>

            <Button Content="清除所有测试数据"
                   Command="{Binding ClearTestDataCommand}"
                   IsEnabled="{Binding !IsGenerating}"
                   Classes="secondary"
                   HorizontalAlignment="Stretch"
                   Padding="16,12"/>

            <Button Content="取消当前操作"
                   Command="{Binding CancelCommand}"
                   IsVisible="{Binding CanCancel}"
                   Classes="secondary"
                   HorizontalAlignment="Stretch"
                   Padding="16,12"/>
        </StackPanel>

        <!-- Progress Bar -->
        <Border Grid.Row="4"
               IsVisible="{Binding IsGenerating}"
               Background="Transparent"
               Padding="16"
               CornerRadius="0"
               Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <ProgressBar Value="{Binding Progress}"
                            Minimum="0"
                            Maximum="100"
                            Height="8"/>
                <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="12"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <Border Grid.Row="5"
               Background="Transparent"
               Padding="16"
               CornerRadius="0"
               Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      TextWrapping="Wrap"
                      TextAlignment="Center"/>
        </Border>

    </Grid>
    </ScrollViewer>
</Window>
