<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="HD2Mimnt.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             KeyDown="OnKeyDown">

    <Design.DataContext>
        <vm:LibraryViewModel />
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Padding="24,12" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="模组库" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="管理已导入的 Mod" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="添加模组" Click="OnImportClicked" Classes="primary" ToolTip.Tip="导入 Mod 到 Library"/>
                        <ComboBox ItemsSource="{Binding DeploymentMethods}" SelectedItem="{Binding CurrentDeploymentMethod}" MinWidth="116" IsEnabled="{Binding !IsDeploying}" ToolTip.Tip="选择部署方式"/>
                        <Button Content="部署当前 Profile" Command="{Binding DeployCommand}" Classes="primary" IsEnabled="{Binding !IsDeploying}" ToolTip.Tip="部署当前 Profile 中全部已启用的 Mod"/>
                        <Button Content="清理最近部署" Command="{Binding CleanupCommand}" Classes="secondary" IsEnabled="{Binding !IsDeploying}" ToolTip.Tip="清理最近一次部署会话记录的文件"/>
                        <Button Content="取消" Command="{Binding CancelDeploymentCommand}" Classes="secondary" IsVisible="{Binding IsDeploying}"/>
                        <Button Content="⋮" Classes="icon-button" FontSize="20" ToolTip.Tip="更多操作">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="刷新模组库" Command="{Binding RefreshCommand}"/>
                                        <MenuItem Header="反选当前筛选结果" Command="{Binding InvertSelectionCommand}"/>
                                    <MenuItem Header="清除筛选" Command="{Binding ClearFiltersCommand}"/>
                                    <MenuItem Header="清空选择" Command="{Binding ClearSelectionCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="24,8" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前 Profile" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentProfileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" ToolTip.Tip="仅表示当前操作上下文，Library 仍显示全部 Mod"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Library 全部 Mod" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding TotalModCount, StringFormat='共 {0:N0} 个'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="搜索名称、作者或描述..." Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" KeyDown="OnSearchBoxKeyDown"/>
                            <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}" Classes="icon-button" Width="24" Height="24" FontSize="12" IsVisible="{Binding SearchText, Converter={StaticResource NotNullConverter}}" ToolTip.Tip="清除搜索"/>
                            <Button Grid.Column="3" Content="搜索" Command="{Binding ExecuteSearchCommand}" Classes="secondary" Margin="6,0,0,0" ToolTip.Tip="执行搜索"/>
                        </Grid>
                    </Border>
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategory}" PlaceholderText="分类" MinWidth="120"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding SortModes}" SelectedItem="{Binding CurrentSortMode}" MinWidth="140"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource Surface0Brush}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="24,8,24,8" VerticalAlignment="Top" ZIndex="2">
                        <RadioButton Content="{Binding TotalModCount, StringFormat='全部 ({0})'}" Command="{Binding FilterCommand}" CommandParameter="All" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=All}"/>
                        <RadioButton Content="{Binding CurrentProfileCount, StringFormat='当前 Profile ({0})'}" Command="{Binding FilterCommand}" CommandParameter="CurrentProfile" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=CurrentProfile}"/>
                        <RadioButton Content="{Binding EnabledCount, StringFormat='当前 Profile 已启用 ({0})'}" Command="{Binding FilterCommand}" CommandParameter="Enabled" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Enabled}"/>
                        <RadioButton Content="{Binding DisabledCount, StringFormat='当前 Profile 未启用 ({0})'}" Command="{Binding FilterCommand}" CommandParameter="Disabled" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Disabled}"/>
                        <RadioButton Content="{Binding DeployedCount, StringFormat='部署状态：已部署 ({0})'}" Command="{Binding FilterCommand}" CommandParameter="Deployed" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Deployed}"/>
                        <RadioButton Content="{Binding NotDeployedCount, StringFormat='部署状态：未部署 ({0})'}" Command="{Binding FilterCommand}" CommandParameter="NotDeployed" GroupName="FilterGroup" Classes="filter-button" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=NotDeployed}"/>
                        <Button Content="清除筛选" Command="{Binding ClearFiltersCommand}" Classes="secondary"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Border Height="40" VerticalAlignment="Top" Padding="24,8" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" ZIndex="1">
                            <Grid ColumnDefinitions="Auto,48,*,Auto,Auto" ColumnSpacing="12">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsAllSelected}" Command="{Binding SelectAllCommand}" ToolTip.Tip="全选当前筛选结果"/>
                                <TextBlock Grid.Column="1" Text="图标" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="模组 · 版本 · 分类 · 作者" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="当前 Profile / 部署状态" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="大小" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    <StackPanel IsVisible="{Binding IsLibraryEmptyStateVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" ZIndex="3">
                        <TextBlock Text="Library 为空" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有导入 Mod" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <Button Content="添加模组" Click="OnImportClicked" Classes="primary" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsSearchEmptyStateVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" ZIndex="3">
                        <TextBlock Text="搜索无结果" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="没有匹配当前搜索条件的 Mod" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <Button Content="清除搜索" Command="{Binding ClearSearchCommand}" Classes="secondary" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsFilterEmptyStateVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" ZIndex="3">
                        <TextBlock Text="筛选无结果" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="没有符合当前 Profile 筛选条件的 Mod" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <Button Content="清除筛选" Command="{Binding ClearFiltersCommand}" Classes="secondary" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsErrorStateVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" ZIndex="3">
                        <TextBlock Text="加载失败" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Center"/>
                        <Button Content="重试" Command="{Binding RefreshCommand}" Classes="primary" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsLoadingStateVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" ZIndex="3">
                        <ProgressBar IsIndeterminate="True" Width="220"/>
                        <TextBlock Text="正在加载 Library..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="ModList" ItemsSource="{Binding FilteredMods}" SelectedItem="{Binding FocusedMod}" SelectedItems="{Binding SelectedMods}" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" Background="Transparent" BorderThickness="0" IsVisible="{Binding IsResultsVisible}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,40,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8" Margin="0">
                                    <Grid ColumnDefinitions="Auto,48,*,Auto,Auto" ColumnSpacing="12">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="4" Background="{DynamicResource Surface3Brush}" ClipToBounds="True" VerticalAlignment="Center">
                                            <Panel>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding Icon, Converter={StaticResource NotNullConverter}}"/>
                                                <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" IsVisible="{Binding !Icon, Converter={StaticResource NotNullConverter}}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetadataLine}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2" MinWidth="190" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProfileStateText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ProfileStateDetailText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsProfileMemberDisabled}"/>
                                            <TextBlock Text="{Binding DeploymentStateText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="4" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding SizeFormatted}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="⋮" Classes="icon-button" FontSize="18" ToolTip.Tip="Mod 操作">
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="启用/禁用当前 Profile Mod" Command="{Binding $parent[UserControl].DataContext.ToggleModEnabledCommand}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="从当前 Profile 移除" Command="{Binding $parent[UserControl].DataContext.RemoveModFromProfileCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsInCurrentProfile}"/>
                                                        <MenuItem Header="查看详情" Command="{Binding $parent[UserControl].DataContext.ShowModDetailCommand}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="从 Library 删除 Mod" Command="{Binding $parent[UserControl].DataContext.DeleteModCommand}" CommandParameter="{Binding}"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" IsVisible="{Binding SelectedCount, Converter={StaticResource GreaterThanZeroConverter}}" Background="{DynamicResource Surface3Brush}" Padding="24,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SelectedCount, StringFormat='已选择 {0} 个 Mod'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="启用当前 Profile Mod" Command="{Binding BatchEnableCommand}" Classes="primary"/>
                        <Button Content="禁用当前 Profile Mod" Command="{Binding BatchDisableCommand}" Classes="secondary"/>
                        <Button Content="从当前 Profile 移除" Command="{Binding RemoveSelectedFromProfileCommand}" Classes="secondary"/>
                        <Button Content="从 Library 删除 Mod" Command="{Binding BatchDeleteCommand}" Classes="secondary"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsDetailPanelOpen}" ZIndex="100">
            <Border Background="#66000000" PointerPressed="OnDetailBackgroundPressed"/>
            <controls:ModDetailPanel DataContext="{Binding SelectedModDetail}" HorizontalAlignment="Right" Width="400"/>
        </Grid>
        <Border Background="#AA05070C" IsVisible="{Binding IsDeploying}" ZIndex="90">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="260"/>
                <TextBlock Text="{Binding DeploymentMessage}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
