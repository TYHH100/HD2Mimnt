<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="HD2Mimnt.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             KeyDown="OnKeyDown">

    <Design.DataContext>
        <vm:LibraryViewModel />
    </Design.DataContext>

    <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Page Title Bar -->
        <Border Grid.Row="0" Padding="24,20" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                          Text="模组库"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="添加模组"
                           Click="OnImportClicked"
                           Classes="primary"/>
                    <ComboBox ItemsSource="{Binding DeploymentMethods}"
                              SelectedItem="{Binding CurrentDeploymentMethod}"
                              Width="120"
                              IsEnabled="{Binding !IsDeploying}"/>
                    <Button Content="部署"
                           Command="{Binding DeployCommand}"
                           Classes="primary"
                           IsEnabled="{Binding !IsDeploying}"/>
                    <Button Content="清理"
                           Command="{Binding CleanupCommand}"
                           Classes="secondary"
                           IsEnabled="{Binding !IsDeploying}"/>
                    <Button Content="取消"
                           Command="{Binding CancelDeploymentCommand}"
                           Classes="secondary"
                           IsVisible="{Binding IsDeploying}"/>
                    <Button Content="⋮"
                           Classes="icon-button"
                           FontSize="20"
                           ToolTip.Tip="更多操作">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="刷新模组库"
                                          Command="{Binding RefreshCommand}"/>
                                <MenuItem Header="清除筛选"
                                          Command="{Binding ClearFiltersCommand}"/>
                                <MenuItem Header="清空选择"
                                          Command="{Binding ClearSelectionCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Filter Bar -->
        <Border Grid.Row="1" Padding="24,16" Background="{DynamicResource Surface1Brush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton Content="{Binding TotalModCount, StringFormat='全部 ({0})'}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="All"
                            GroupName="FilterGroup"
                            Classes="filter-button"
                            IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=All}"/>
                <RadioButton Content="{Binding EnabledCount, StringFormat='已启用 ({0})'}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="Enabled"
                            GroupName="FilterGroup"
                            Classes="filter-button"
                            IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Enabled}"/>
                <RadioButton Content="{Binding DisabledCount, StringFormat='未启用 ({0})'}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="Disabled"
                            GroupName="FilterGroup"
                            Classes="filter-button"
                            IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Disabled}"/>
                <RadioButton Content="{Binding DeployedCount, StringFormat='已部署 ({0})'}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="Deployed"
                            GroupName="FilterGroup"
                            Classes="filter-button"
                            IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=Deployed}"/>
                <RadioButton Content="{Binding NotDeployedCount, StringFormat='未部署 ({0})'}"
                            Command="{Binding FilterCommand}"
                            CommandParameter="NotDeployed"
                            GroupName="FilterGroup"
                            Classes="filter-button"
                            IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualConverter}, ConverterParameter=NotDeployed}"/>
                <Button Content="清除筛选"
                        Command="{Binding ClearFiltersCommand}"
                        Classes="secondary"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Search Toolbar -->
        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Search Box -->
                <Border Grid.Column="0"
                       Background="{DynamicResource Surface2Brush}"
                       BorderBrush="{DynamicResource BorderStrongBrush}"
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                  Text="🔍"
                                  FontSize="16"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                x:Name="SearchBox"
                                Text="{Binding SearchText}"
                                PlaceholderText="搜索模组..."
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                               Content="✕"
                               Command="{Binding ClearSearchCommand}"
                               Classes="icon-button"
                               Width="24"
                               Height="24"
                               FontSize="12"
                               IsVisible="{Binding SearchText, Converter={StaticResource NotNullConverter}}"
                               ToolTip.Tip="清除搜索"/>
                    </Grid>
                </Border>

                <!-- Category Filter -->
                <ComboBox Grid.Column="1"
                         ItemsSource="{Binding AvailableCategories}"
                         SelectedItem="{Binding SelectedCategory}"
                         PlaceholderText="分类"
                         MinWidth="120"
                         Margin="12,0,0,0"/>

                <!-- Sort Dropdown -->
                <ComboBox Grid.Column="2"
                         ItemsSource="{Binding SortModes}"
                         SelectedItem="{Binding CurrentSortMode}"
                         MinWidth="140"
                         Margin="12,0,0,0"/>

            </Grid>
        </Border>

        <!-- List Header -->
        <Border Grid.Row="3" Padding="24,12" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <CheckBox Grid.Column="0"
                         IsChecked="{Binding IsAllSelected}"
                         Command="{Binding SelectAllCommand}"
                         Content="全选"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"/>
                <Button Grid.Column="1"
                        Content="反选"
                        Command="{Binding InvertSelectionCommand}"
                        Classes="secondary"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2"
                          Text="{Binding FilteredModCount, StringFormat='共 {0:N0} 个模组'}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="13"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Mod List (Virtualized) -->
        <Border Grid.Row="4" Background="{DynamicResource Surface0Brush}">
            <Grid>
                <!-- Empty State -->
                <StackPanel IsVisible="{Binding IsEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="16">
                    <TextBlock Text="📦"
                              FontSize="64"
                              HorizontalAlignment="Center"
                              Opacity="0.3"/>
                    <TextBlock Text="还没有模组"
                              FontSize="18"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="点击 &#34;添加模组&#34; 导入你的第一个模组"
                              FontSize="14"
                              Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center"/>
                    <Button Content="添加模组"
                           Click="OnImportClicked"
                           Classes="primary"/>
                </StackPanel>

                <!-- Search/filter returned no results -->
                <StackPanel IsVisible="{Binding HasNoResults}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="12">
                    <TextBlock Text="没有匹配的模组"
                              FontSize="18"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="请调整搜索或筛选条件"
                              FontSize="14"
                              Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center"/>
                    <Button Content="清除搜索"
                           Command="{Binding ClearSearchCommand}"
                           Classes="secondary"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error State -->
                <StackPanel IsVisible="{Binding HasError}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="16">
                    <TextBlock Text="⚠"
                              FontSize="64"
                              HorizontalAlignment="Center"
                              Foreground="#EF4444"
                              Opacity="0.5"/>
                    <TextBlock Text="加载失败"
                              FontSize="18"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                              FontSize="14"
                              Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"
                              MaxWidth="400"/>
                    <Button Content="重试"
                           Command="{Binding RefreshCommand}"
                           Classes="primary"/>
                </StackPanel>

                <!-- Loading State -->
                <StackPanel IsVisible="{Binding IsLoading}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="16">
                    <TextBlock Text="⏳"
                              FontSize="64"
                              HorizontalAlignment="Center"
                              Opacity="0.5"/>
                    <TextBlock Text="加载中..."
                              FontSize="18"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Virtualized Mod List -->
                <ListBox x:Name="ModList"
                        ItemsSource="{Binding FilteredMods}"
                        SelectedItem="{Binding FocusedMod}"
                        SelectedItems="{Binding SelectedMods}"
                        SelectionMode="Multiple"
                        SelectionChanged="OnSelectionChanged"
                        Background="Transparent"
                        BorderThickness="0"
                        IsVisible="{Binding HasFilteredResults}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface2Brush}"
                               BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="0,0,0,1"
                               Padding="{Binding $parent[UserControl].DataContext.ModItemPadding}"
                               Margin="0">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                <!-- Selection CheckBox -->
                                <CheckBox Grid.Column="0"
                                         IsChecked="{Binding IsSelected}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                                <!-- Mod Icon -->
                                <Border Grid.Column="1"
                                       Width="48"
                                       Height="48"
                                       CornerRadius="6"
                                       Background="{DynamicResource Surface3Brush}"
                                       ClipToBounds="True"
                                       Margin="0,0,16,0">
                                    <Panel>
                                        <Image Source="{Binding Icon}"
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding Icon, Converter={StaticResource NotNullConverter}}"/>
                                        <TextBlock Text="📦"
                                                  FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.3"
                                                  IsVisible="{Binding !Icon, Converter={StaticResource NotNullConverter}}"/>
                                    </Panel>
                                </Border>

                                <!-- Mod Info -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                              FontSize="15"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Version}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="|"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource BorderStrongBrush}"/>
                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="|"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource BorderStrongBrush}"/>
                                        <TextBlock Text="{Binding Author}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#22C55E"
                                               CornerRadius="4"
                                               Padding="8,2"
                                               IsVisible="{Binding IsEnabled}">
                                            <TextBlock Text="✓ 已启用"
                                                      FontSize="11"
                                                      Foreground="#FFFFFF"
                                                      FontWeight="Medium"/>
                                        </Border>
                                        <Border Background="#38BDF8"
                                               CornerRadius="4"
                                               Padding="8,2"
                                               IsVisible="{Binding IsDeployed}">
                                            <TextBlock Text="● 已部署"
                                                      FontSize="11"
                                                      Foreground="#FFFFFF"
                                                      FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- File Size -->
                                <TextBlock Grid.Column="3"
                                          Text="{Binding SizeFormatted}"
                                          FontSize="13"
                                          Foreground="{DynamicResource TextMutedBrush}"
                                          VerticalAlignment="Center"
                                          Margin="16,0"/>

                                <!-- More Menu Button -->
                                <Button Grid.Column="4"
                                       Content="⋮"
                                       Classes="icon-button"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="更多操作">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="启用/禁用"
                                                     Command="{Binding $parent[UserControl].DataContext.ToggleModEnabledCommand}"
                                                     CommandParameter="{Binding}"/>
                                            <MenuItem Header="查看详情"
                                                     Command="{Binding $parent[UserControl].DataContext.ShowModDetailCommand}"
                                                     CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="删除"
                                                     Command="{Binding $parent[UserControl].DataContext.DeleteModCommand}"
                                                     CommandParameter="{Binding}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </Border>

        <!-- Batch Operation Bar (Conditional) -->
        <Border Grid.Row="5"
               IsVisible="{Binding SelectedCount, Converter={StaticResource GreaterThanZeroConverter}}"
               Background="{DynamicResource Surface3Brush}"
               Padding="24,12"
               BorderBrush="{DynamicResource BorderBrush}"
               BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                          Text="{Binding SelectedCount, StringFormat='已选择 {0} 个模组'}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontWeight="Medium"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="启用"
                           Command="{Binding BatchEnableCommand}"
                           Classes="primary"/>
                    <Button Content="禁用"
                           Command="{Binding BatchDisableCommand}"
                           Classes="secondary"/>
                    <Button Content="删除"
                           Command="{Binding BatchDeleteCommand}"
                           Classes="secondary"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Mod Detail Panel (Overlay) -->
    <Grid Grid.Row="0" Grid.RowSpan="6"
          IsVisible="{Binding IsDetailPanelOpen}"
          ZIndex="100">
        <Border Background="#CC000000"
                PointerPressed="OnDetailBackgroundPressed"/>
        <controls:ModDetailPanel DataContext="{Binding SelectedModDetail}"
                                HorizontalAlignment="Right"
                                Width="400"/>
    </Grid>

    <Border Background="#AA05070C"
            IsVisible="{Binding IsDeploying}"
            ZIndex="90">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="260"/>
            <TextBlock Text="{Binding DeploymentMessage}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
    </Panel>
</UserControl>
