<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.LogView" x:DataType="vm:LogViewModel">
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <StackPanel Spacing="3">
        <TextBlock Text="日志与诊断" Classes="section-title"/>
        <TextBlock Text="仅读取最近 500 条记录，避免打开日志时持续占用内存。" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
      <CheckBox Grid.Column="1" Content="仅显示错误" IsChecked="{Binding ErrorsOnly}" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Classes="secondary" VerticalAlignment="Center"/>
      <Button Grid.Column="3" Content="复制" Command="{Binding CopyCommand}" Classes="secondary" VerticalAlignment="Center"/>
      <Button Grid.Column="4" Content="导出" Command="{Binding ExportCommand}" Classes="secondary" VerticalAlignment="Center"/>
    </Grid>
    <Border Classes="card" Padding="0">
      <ListBox Height="420" ItemsSource="{Binding EntryItems}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogEntryViewModel">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="150,78,*,Auto" Margin="14,7">
              <TextBlock Text="{Binding TimestampText}" FontSize="12" FontFamily="Consolas" Classes="muted" VerticalAlignment="Top"/>
              <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top"
                         Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                         Classes.accent-text="{Binding IsInformation}" Classes.muted="{Binding IsDiagnostic}">
                <TextBlock.Styles>
                  <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Style>
                  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></Style>
                </TextBlock.Styles>
              </TextBlock>
              <TextBlock Grid.Column="2" Text="{Binding Logger}" FontSize="12" FontFamily="Consolas" Classes="muted" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" Text="正在加载..." Classes="muted" IsVisible="{Binding IsLoading}"/>
    </Grid>
  </StackPanel>
</UserControl>
