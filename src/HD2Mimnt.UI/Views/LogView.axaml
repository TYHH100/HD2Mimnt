<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.LogView" x:DataType="vm:LogViewModel">
  <Grid RowDefinitions="Auto,*,Auto" MinHeight="360">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
      <StackPanel Spacing="3"><TextBlock Text="日志与诊断" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="仅读取最近 500 条记录，避免打开日志时持续占用内存。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><CheckBox Content="仅显示错误" IsChecked="{Binding ErrorsOnly}" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel>
      <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" Classes="secondary" Margin="8,0,0,0"/>
      <Button Grid.Column="2" Content="复制" Command="{Binding CopyCommand}" Classes="secondary" Margin="8,0,0,0"/>
      <Button Grid.Column="3" Content="导出" Command="{Binding ExportCommand}" Classes="secondary" Margin="8,0,0,0"/>
    </Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}"/>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0"><TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding IsLoading, StringFormat='加载中：{0}'}" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
  </Grid>
</UserControl>
