<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels" xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Views.ModCreationDirectoryPicker">
  <TreeView Name="CreationDirectoryTree" MinWidth="280" Height="340"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <TreeView.Styles>
      <Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style>
    </TreeView.Styles>
    <TreeView.ItemTemplate>
      <TreeDataTemplate x:DataType="vm:ModCreationDirectoryViewModel" ItemsSource="{Binding Children}">
        <CheckBox IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding RelativePath}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:UtilityIcon Kind="Folder" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
          </StackPanel>
        </CheckBox>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
