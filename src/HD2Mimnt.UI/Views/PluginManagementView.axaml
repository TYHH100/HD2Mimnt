<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="HD2Mimnt.UI.Views.PluginManagementView"
             x:DataType="vm:PluginManagementViewModel"
             Background="#05070C">

    <Design.DataContext>
        <vm:PluginManagementViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Plugin Management"
                      FontSize="24"
                      FontWeight="SemiBold"
                      Foreground="#E0E0E0"/>
            <TextBlock Text="Manage and configure third-party plugins"
                      FontSize="14"
                      Foreground="#9CA3AF"/>
        </StackPanel>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,20">
            <Grid.Styles>
                <Style Selector="Border.stat-card">
                    <Setter Property="Background" Value="#0F131C"/>
                    <Setter Property="BorderBrush" Value="#1E2636"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="16"/>
                </Style>
            </Grid.Styles>

            <!-- Total Plugins -->
            <Border Grid.Column="0" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Total Plugins"
                              FontSize="12"
                              Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding TotalPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#E0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Enabled -->
            <Border Grid.Column="1" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Enabled"
                              FontSize="12"
                              Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding EnabledPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#6EE7B7"/>
                </StackPanel>
            </Border>

            <!-- Disabled -->
            <Border Grid.Column="2" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Disabled"
                              FontSize="12"
                              Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding DisabledPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#6B7280"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Grid.Column="3" Classes="stat-card">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <Button Content="Install Plugin"
                           Command="{Binding InstallPluginCommand}"
                           Padding="16,8"
                           CornerRadius="999"
                           Background="#38BDF8"
                           Foreground="#05070C"
                           FontWeight="Medium"
                           HorizontalAlignment="Stretch"
                           BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           Padding="16,8"
                           CornerRadius="999"
                           Background="#161D2B"
                           Foreground="#9CA3AF"
                           BorderBrush="#1E2636"
                           BorderThickness="1"
                           HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#1E2636"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Plugin List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding InstalledPlugins}"
                             IsVisible="{Binding !!InstalledPlugins.Count}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F131C"
                               BorderBrush="#1E2636"
                               BorderThickness="1"
                               CornerRadius="6"
                               Padding="20"
                               Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <!-- Plugin Icon -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                       Width="64" Height="64"
                                       CornerRadius="8"
                                       Background="#161D2B"
                                       VerticalAlignment="Top"
                                       Margin="0,0,16,0">
                                    <TextBlock Text="📦"
                                             FontSize="32"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: Name and Status -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="#E0E0E0"
                                             VerticalAlignment="Center"/>

                                    <!-- Status Badge -->
                                    <Border CornerRadius="999"
                                           Padding="8,4">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1E4620"/>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                     FontSize="11"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                     FontSize="11"
                                                     FontWeight="Medium"
                                                     Foreground="#E0E0E0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Permission Mode Badge -->
                                    <Border Background="#1E2636"
                                           CornerRadius="999"
                                           Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding PermissionModeIcon}"
                                                     FontSize="11"/>
                                            <TextBlock Text="{Binding PermissionModeDisplay}"
                                                     FontSize="11"
                                                     FontWeight="Medium"
                                                     Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Row 1: Version, Author, Install Date -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Version}"
                                             FontSize="12"
                                             Foreground="#9CA3AF"/>
                                    <TextBlock Text="•"
                                             FontSize="12"
                                             Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding Author}"
                                             FontSize="12"
                                             Foreground="#9CA3AF"/>
                                    <TextBlock Text="•"
                                             FontSize="12"
                                             Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding InstalledAtFormatted, StringFormat='Installed: {0}'}"
                                             FontSize="12"
                                             Foreground="#9CA3AF"/>
                                </StackPanel>

                                <!-- Row 2: Description -->
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                          Text="{Binding Description}"
                                          FontSize="13"
                                          Foreground="#9CA3AF"
                                          TextWrapping="Wrap"
                                          MaxWidth="600"
                                          HorizontalAlignment="Left"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                           Orientation="Vertical"
                                           Spacing="8"
                                           VerticalAlignment="Center">

                                    <Button Content="Enable"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).EnablePluginCommand}"
                                           CommandParameter="{Binding}"
                                           IsVisible="{Binding !IsEnabled}"
                                           Padding="16,8"
                                           CornerRadius="999"
                                           Background="#161D2B"
                                           Foreground="#6EE7B7"
                                           BorderBrush="#1E2636"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#1E2636"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="Disable"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).DisablePluginCommand}"
                                           CommandParameter="{Binding}"
                                           IsVisible="{Binding IsEnabled}"
                                           Padding="16,8"
                                           CornerRadius="999"
                                           Background="#161D2B"
                                           Foreground="#9CA3AF"
                                           BorderBrush="#1E2636"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#1E2636"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="History"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).ViewExecutionHistoryCommand}"
                                           CommandParameter="{Binding}"
                                           Padding="16,8"
                                           CornerRadius="999"
                                           Background="#161D2B"
                                           Foreground="#9CA3AF"
                                           BorderBrush="#1E2636"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#1E2636"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="Uninstall"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).UninstallPluginCommand}"
                                           CommandParameter="{Binding}"
                                           Padding="16,8"
                                           CornerRadius="999"
                                           Background="#1E0F0F"
                                           Foreground="#E94560"
                                           BorderBrush="#E94560"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#2A1818"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border IsVisible="{Binding !InstalledPlugins.Count}"
                   Background="#0F131C"
                   BorderBrush="#1E2636"
                   BorderThickness="1"
                   CornerRadius="6"
                   Padding="48"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="📦"
                              FontSize="48"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="No Plugins Installed"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="#E0E0E0"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Install a plugin to extend HD2Mimnt functionality"
                              FontSize="13"
                              Foreground="#9CA3AF"
                              HorizontalAlignment="Center"/>
                    <Button Content="Install Plugin"
                           Command="{Binding InstallPluginCommand}"
                           Padding="24,10"
                           CornerRadius="999"
                           Background="#38BDF8"
                           Foreground="#05070C"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#0F131C" BorderBrush="#1E2636" BorderThickness="0,1,0,0" Padding="16,12" Margin="-24,16,-24,-24">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                          Text="{Binding StatusMessage}"
                          FontSize="12"
                          Foreground="#9CA3AF"/>

                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="8"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding IsLoading}">
                    <TextBlock Text="⏳"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Loading..."
                              FontSize="12"
                              Foreground="#9CA3AF"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
