<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="HD2Mimnt.UI.Views.PluginManagementView"
             x:DataType="vm:PluginManagementViewModel"
             Background="{DynamicResource Surface0Brush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <TextBlock Text="Plugin Management"
                      FontSize="24"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage and configure third-party plugins"
                      FontSize="14"
                      Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,20">
            <Grid.Styles>
                <Style Selector="Border.stat-card">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="16"/>
                </Style>
            </Grid.Styles>

            <!-- Total Plugins -->
            <Border Grid.Column="0" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Total Plugins"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Enabled -->
            <Border Grid.Column="1" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Enabled"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EnabledPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#6EE7B7"/>
                </StackPanel>
            </Border>

            <!-- Disabled -->
            <Border Grid.Column="2" Classes="stat-card" Margin="0,0,8,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Disabled"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DisabledPlugins}"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Grid.Column="3" Classes="stat-card">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <Button Content="Install Plugin"
                           Click="OnInstallPluginClicked"
                           Padding="16,8"
                           CornerRadius="4"
                           Background="#38BDF8"
                           Foreground="{DynamicResource Surface0Brush}"
                           FontWeight="Medium"
                           HorizontalAlignment="Stretch"
                           BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           Padding="16,8"
                           CornerRadius="4"
                           Background="{DynamicResource Surface3Brush}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Plugin List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding InstalledPlugins}"
                             IsVisible="{Binding !!InstalledPlugins.Count}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface2Brush}"
                               BorderBrush="{DynamicResource BorderBrush}"
                               BorderThickness="1"
                               CornerRadius="6"
                               Padding="20"
                               Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <!-- Plugin Icon -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                       Width="64" Height="64"
                                       CornerRadius="6"
                                       Background="{DynamicResource Surface3Brush}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,16,0">
                                    <TextBlock Text="📦"
                                             FontSize="32"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: Name and Status -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             VerticalAlignment="Center"/>

                                    <!-- Status Badge -->
                                    <Border CornerRadius="999"
                                           Padding="8,4">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1E4620"/>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                     FontSize="11"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                     FontSize="11"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Permission Mode Badge -->
                                    <Border Background="{DynamicResource BorderBrush}"
                                           CornerRadius="4"
                                           Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding PermissionModeIcon}"
                                                     FontSize="11"/>
                                            <TextBlock Text="{Binding PermissionModeDisplay}"
                                                     FontSize="11"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Row 1: Version, Author, Install Date -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Version}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="•"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Author}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="•"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding InstalledAtFormatted, StringFormat='Installed: {0}'}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Row 2: Description -->
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                          Text="{Binding Description}"
                                          FontSize="13"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          MaxWidth="600"
                                          HorizontalAlignment="Left"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                           Orientation="Vertical"
                                           Spacing="8"
                                           VerticalAlignment="Center">

                                    <Button Content="Enable"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).EnablePluginCommand}"
                                           CommandParameter="{Binding}"
                                           IsVisible="{Binding !IsEnabled}"
                                           Padding="16,8"
                                           CornerRadius="4"
                                           Background="{DynamicResource Surface3Brush}"
                                           Foreground="#6EE7B7"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="Disable"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).DisablePluginCommand}"
                                           CommandParameter="{Binding}"
                                           IsVisible="{Binding IsEnabled}"
                                           Padding="16,8"
                                           CornerRadius="4"
                                           Background="{DynamicResource Surface3Brush}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="History"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).ViewExecutionHistoryCommand}"
                                           CommandParameter="{Binding}"
                                           Padding="16,8"
                                           CornerRadius="4"
                                           Background="{DynamicResource Surface3Brush}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="权限"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).EditPermissionsCommand}"
                                           CommandParameter="{Binding}"
                                           Padding="16,8"
                                           CornerRadius="4"
                                           Background="{DynamicResource Surface3Brush}"
                                           Foreground="#C4B5FD"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>

                                    <Button Content="Uninstall"
                                           Command="{Binding $parent[ItemsControl].((vm:PluginManagementViewModel)DataContext).UninstallPluginCommand}"
                                           CommandParameter="{Binding}"
                                           Padding="16,8"
                                           CornerRadius="4"
                                           Background="#1E0F0F"
                                           Foreground="#E94560"
                                           BorderBrush="#E94560"
                                           BorderThickness="1"
                                           MinWidth="100">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#2A1818"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border IsVisible="{Binding !InstalledPlugins.Count}"
                   Background="{DynamicResource Surface2Brush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   CornerRadius="6"
                   Padding="48"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="📦"
                              FontSize="48"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="No Plugins Installed"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Install a plugin to extend HD2Mimnt functionality"
                              FontSize="13"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <Button Content="Install Plugin"
                           Click="OnInstallPluginClicked"
                           Padding="24,10"
                           CornerRadius="4"
                           Background="#38BDF8"
                           Foreground="{DynamicResource Surface0Brush}"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" Margin="-24,16,-24,-24">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                          Text="{Binding StatusMessage}"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           Spacing="8"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding IsLoading}">
                    <TextBlock Text="⏳"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Loading..."
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border IsVisible="{Binding IsHistoryOpen}" Background="#CC05070C" ZIndex="20">
            <Border Width="680" Height="460" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding HistoryPlugin.Name, StringFormat='执行历史：{0}'}" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseHistoryCommand}" Classes="secondary"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExecutionHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151B26" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding StartTime, StringFormat='开始：{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" Foreground="#F87171" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" IsVisible="{Binding ExecutionHistory.Count, Converter={StaticResource EqualConverter}, ConverterParameter=0}" Text="暂无执行记录" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
