<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.PluginManagementView" x:DataType="vm:PluginManagementViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,0,4">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><StackPanel Spacing="3"><TextBlock Text="插件管理" Classes="section-title" /><TextBlock Text="管理已安装的扩展及其权限。" Classes="muted" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="安装插件" Classes="accent" Click="OnInstallPluginClicked" /><Button Content="刷新" Command="{Binding RefreshCommand}" /></StackPanel></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="24" Margin="0,0,0,12"><TextBlock Text="插件" Classes="muted" /><TextBlock Text="{Binding TotalPlugins, StringFormat='总数 {0}'}" /><TextBlock Text="{Binding EnabledPlugins, StringFormat='已启用 {0}'}" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Classes="muted" HorizontalAlignment="Right" /></Grid>
    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding InstalledPlugins}" IsVisible="{Binding !!InstalledPlugins.Count}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PluginItemViewModel"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,10"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" Classes="section-title" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" Classes="muted" /><TextBlock Text="{Binding Author, StringFormat='作者 {0}'}" Classes="muted" /></StackPanel><TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding PermissionModeDisplay, StringFormat='权限模式：{0}'}" Classes="muted" FontSize="12" /></StackPanel><StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="启用" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).EnablePluginCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEnabled}" /><Button Content="停用" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).DisablePluginCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsEnabled}" /><Button Content="权限" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).EditPermissionsCommand}" CommandParameter="{Binding}" /><Button Content="历史" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).ViewExecutionHistoryCommand}" CommandParameter="{Binding}" /><Button Content="卸载" Classes="danger" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).UninstallPluginCommand}" CommandParameter="{Binding}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel IsVisible="{Binding !InstalledPlugins.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="尚未安装插件" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="安装插件后可在这里管理权限与运行记录。" Classes="muted" HorizontalAlignment="Center" /><Button Content="安装插件" Classes="accent" Click="OnInstallPluginClicked" HorizontalAlignment="Center" /></StackPanel>
    </Grid>
  </Grid>
</UserControl>
