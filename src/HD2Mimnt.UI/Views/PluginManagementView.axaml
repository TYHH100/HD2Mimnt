<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.PluginManagementView" x:DataType="vm:PluginManagementViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,0,4">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12"><StackPanel Spacing="3"><TextBlock Text="{loc:Loc UI.PluginManagement}" Classes="section-title" /><TextBlock Text="{loc:Loc UI.ManageInstalledExtensionsAndTheirPermissions}" Classes="muted" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{loc:Loc UI.InstallPlugin}" Classes="accent" Click="OnInstallPluginClicked" /><Button Content="{loc:Loc UI.Refresh}" Command="{Binding RefreshCommand}" /></StackPanel></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="24" Margin="0,0,0,12"><TextBlock Text="{loc:Loc UI.Plugins}" Classes="muted" /><TextBlock Text="{loc:LocalizedBinding TotalPlugins, FormatKey=UI.Total}" /><TextBlock Text="{loc:LocalizedBinding EnabledPlugins, FormatKey=UI.Enabled.47ae02ee}" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Grid.Column="3" Text="{loc:LocalizedBinding StatusMessage}" Classes="muted" HorizontalAlignment="Right" /></Grid>
    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding InstalledPlugins}" IsVisible="{Binding !!InstalledPlugins.Count}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PluginItemViewModel"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,10"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" Classes="section-title" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{loc:LocalizedBinding Version, FormatKey=UI.Version.ce0744e6}" Classes="muted" /><TextBlock Text="{loc:LocalizedBinding Author, FormatKey=UI.Author.cb8ce501}" Classes="muted" /></StackPanel><TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{loc:LocalizedBinding PermissionModeDisplay, FormatKey=UI.PermissionMode, TranslateValue=True}" Classes="muted" FontSize="12" /></StackPanel><StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="{loc:Loc UI.Enable}" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).EnablePluginCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEnabled}" /><Button Content="{loc:Loc UI.Disable.4e6fd0e2}" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).DisablePluginCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsEnabled}" /><Button Content="{loc:Loc UI.Permissions}" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).EditPermissionsCommand}" CommandParameter="{Binding}" /><Button Content="{loc:Loc UI.History}" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).ViewExecutionHistoryCommand}" CommandParameter="{Binding}" /><Button Content="{loc:Loc UI.Uninstall}" Classes="danger" Command="{Binding $parent[ListBox].((vm:PluginManagementViewModel)DataContext).UninstallPluginCommand}" CommandParameter="{Binding}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel IsVisible="{Binding !InstalledPlugins.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{loc:Loc UI.NoPluginsInstalled}" Classes="section-title" HorizontalAlignment="Center" /><TextBlock Text="{loc:Loc UI.InstallAPluginToManageItsPermissionsAndExecutionHistoryHere}" Classes="muted" HorizontalAlignment="Center" /><Button Content="{loc:Loc UI.InstallPlugin}" Classes="accent" Click="OnInstallPluginClicked" HorizontalAlignment="Center" /></StackPanel>
    </Grid>
  </Grid>
</UserControl>
