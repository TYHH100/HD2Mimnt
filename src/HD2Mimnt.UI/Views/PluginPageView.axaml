<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="HD2Mimnt.UI.Views.PluginPageView"
             x:DataType="vm:PluginUiSurfaceViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="{Binding PageMargin}">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12" IsVisible="{Binding !FillWindow}">
            <TextBlock Text="{Binding Title}"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Description}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:PluginWebView2Control x:Name="WebSurface"
                                            IsVisible="{Binding IsWebViewActive}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsDeclarative}">
                <controls:PluginUiPresenter x:Name="SurfacePresenter" Surface="{Binding}"/>
            </ScrollViewer>
            <Border IsVisible="{Binding HasWebError}"
                    Background="{DynamicResource Surface2Brush}"
                    Padding="24"
                    CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="520">
                    <TextBlock Text="{Binding WebErrorMessage}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button Classes="accent" Content="{loc:Loc PluginWebView.Reload}" Click="OnReloadWebViewClick"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                   IsVisible="{Binding !FillWindow}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
