<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="HD2Mimnt.UI.Views.PluginPageView"
             x:DataType="vm:PluginUiSurfaceViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,16,24,20">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Description}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <controls:PluginUiPresenter x:Name="SurfacePresenter" Surface="{Binding}"/>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,10,0,0"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
