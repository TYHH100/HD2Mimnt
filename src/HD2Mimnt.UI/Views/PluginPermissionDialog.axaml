<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HD2Mimnt.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
        x:Class="HD2Mimnt.UI.Views.PluginPermissionDialog"
        x:DataType="vm:PluginPermissionDialogViewModel"
        Title="插件权限请求"
        Width="600" Height="700"
        MinWidth="500" MinHeight="500"
        MaxWidth="700" MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface1Brush}"
        CanResize="False">

    <Design.DataContext>
        <vm:PluginPermissionDialogViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel Spacing="8">
                <TextBlock Text="插件权限请求"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="此插件请求访问系统资源的权限。"
                          FontSize="13"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="24,20">
                <!-- Plugin Info Card -->
                <Border Background="{DynamicResource Surface2Brush}"
                       CornerRadius="6"
                       BorderBrush="{DynamicResource BorderBrush}"
                       BorderThickness="1"
                       Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="80,*">
                        <!-- Icon -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4"
                               Width="64" Height="64"
                               CornerRadius="6"
                               Background="{DynamicResource Surface3Brush}"
                               VerticalAlignment="Top"
                               Margin="0,0,12,0">
                            <TextBlock Text="插件"
                                     FontSize="32"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>

                        <!-- Plugin Name -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                  Text="{Binding PluginName}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>

                        <!-- Version & Author -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <TextBlock Text="{Binding PluginVersion}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="•"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding PluginAuthor}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                  Text="{Binding PluginDescription}"
                                  FontSize="13"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,8"/>

                        <!-- Permission Mode Badge -->
                        <Border Grid.Row="3" Grid.Column="1"
                               Background="{DynamicResource BorderBrush}"
                               CornerRadius="999"
                               Padding="10,4"
                               HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding PermissionModeIcon}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding PermissionMode}"
                                         FontSize="12"
                                         FontWeight="Medium"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Warning Banner -->
                <Border IsVisible="{Binding ShowWarning}"
                       Background="#1E1506"
                       BorderBrush="#E9A568"
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="16">
                    <TextBlock Text="{Binding WarningMessage}"
                              FontSize="13"
                              Foreground="#E9A568"
                              TextWrapping="Wrap"/>
                </Border>

                <!-- Requested Permissions Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="请求的权限"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding RequestedPermissions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface2Brush}"
                                       CornerRadius="6"
                                       BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       Padding="12"
                                       Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Icon -->
                                        <TextBlock Grid.Column="0"
                                                 Text="{Binding Icon}"
                                                 FontSize="20"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>

                                        <!-- Permission Info -->
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                     FontSize="13"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Risk and management state -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border IsVisible="{Binding IsHighRisk}"
                                                   Background="#1E0F0F"
                                                   BorderBrush="#E94560"
                                                   BorderThickness="1"
                                                   CornerRadius="999"
                                                   Padding="8,4">
                                                <TextBlock Text="高风险"
                                                         FontSize="11"
                                                         FontWeight="Medium"
                                                         Foreground="#E94560"/>
                                            </Border>
                                            <CheckBox IsVisible="{Binding CanEdit}"
                                                     IsChecked="{Binding IsGranted}"
                                                     VerticalAlignment="Center"
                                                     ToolTip.Tip="授予此权限"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Information Text -->
                <TextBlock IsVisible="{Binding !IsManagementMode}" Text="仅本次允许：仅在本次会话授予权限&#x0a;始终允许：记住此决定，不再询问&#x0a;拒绝：不安装此插件"
                          FontSize="12"
                          Foreground="{DynamicResource TextMutedBrush}"
                          TextWrapping="Wrap"
                          Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsManagementMode}">
                    <TextBlock Text="勾选需要授予的权限" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="拒绝"
                           IsVisible="{Binding !IsManagementMode}"
                           Command="{Binding DenyCommand}"
                           CommandParameter="{Binding $parent[Window]}"
                           Padding="24,10"
                           CornerRadius="4"
                           Background="{DynamicResource Surface3Brush}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           MinWidth="100">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <Button Content="仅本次允许"
                           IsVisible="{Binding !IsManagementMode}"
                           Command="{Binding AllowOnceCommand}"
                           CommandParameter="{Binding $parent[Window]}"
                           Padding="24,10"
                           CornerRadius="4"
                           Background="{DynamicResource BorderBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           BorderBrush="#38BDF8"
                           BorderThickness="1"
                           MinWidth="120">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#2A3644"/>
                                <Setter Property="BorderBrush" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <Button Content="始终允许"
                           IsVisible="{Binding !IsManagementMode}"
                           Command="{Binding AllowAlwaysCommand}"
                           CommandParameter="{Binding $parent[Window]}"
                           Padding="24,10"
                           CornerRadius="4"
                           Background="#38BDF8"
                           Foreground="{DynamicResource Surface0Brush}"
                           BorderThickness="0"
                           FontWeight="Medium"
                           MinWidth="120">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#60D5FF"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Content="取消"
                           IsVisible="{Binding IsManagementMode}"
                           Command="{Binding CancelEditCommand}"
                           CommandParameter="{Binding $parent[Window]}"
                           Classes="secondary"/>
                    <Button Content="保存权限"
                           IsVisible="{Binding IsManagementMode}"
                           Command="{Binding SavePermissionsCommand}"
                           CommandParameter="{Binding $parent[Window]}"
                           Classes="primary"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
