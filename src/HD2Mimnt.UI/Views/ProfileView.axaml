<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

<UserControl.Styles>
  <!-- 复用 FluentAvalonia 原生 ListBoxItem 模板，只调整内容布局，不覆盖选中态模板。 -->
  <Style Selector="ListBoxItem.profile-mod-item">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem.option-choice-item">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,4"/>
  </Style>
</UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="240,*" Margin="24,16,24,20">

    <!-- ══ 左侧操作面板（旧版 FluentElevatedCard + FluentNavigationButton 结构）══ -->
    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Classes="card" Padding="12" Margin="0,0,16,0">
      <DockPanel>
        <!-- 顶部：新建 / 添加模组 -->
        <StackPanel x:Name="CreateProfilePanel" DockPanel.Dock="Top" Spacing="2">
          <TextBox PlaceholderText="新配置文件名称" Text="{Binding NewProfileName}" Margin="0,2,0,6" />
          <Button Classes="side-nav" Command="{Binding CreateProfileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:UtilityIcon Kind="Add" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="新建配置文件" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>
          <Button x:Name="AddProfileModButton" Classes="side-nav" Command="{Binding OpenAddModCommand}" IsEnabled="{Binding HasSelectedProfile}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:UtilityIcon Kind="Package" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="添加模组" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>
          <Button x:Name="AddProfileSeparatorButton" Classes="side-nav" Command="{Binding OpenAddSeparatorCommand}" IsEnabled="{Binding HasSelectedProfile}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:UtilityIcon Kind="Add" Width="16" Height="16"/>
              <TextBlock Text="添加分组分隔符"/>
            </StackPanel>
          </Button>
          <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8"/>
          <TextBlock Text="全部配置文件" Classes="secondary-text" FontWeight="SemiBold" Margin="10,0,0,6"/>
        </StackPanel>

        <!-- 底部：检查冲突 + 排序/部署顺序提示（旧版底部工具区） -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8"/>
          <Button Classes="side-nav" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenConflictsAndScanCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:UtilityIcon Kind="Warning" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Text="检查冲突" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>
          <TextBlock Classes="caption-text" TextWrapping="Wrap" Margin="10,6,4,2"
                     Text="列表顺序即部署顺序，靠后的模组覆盖同名文件；部署时仅部署已启用的模组。新建的配置文件会依次排在其后，可拖动调整顺序；默认配置固定在第一位。右键配置文件可复制、重命名或删除。"/>
        </StackPanel>

        <!-- 中部：配置文件列表（填充剩余空间，可拖动排序；第一位默认配置固定；右键弹操作菜单） -->
        <ListBox x:Name="ProfileList"
                 ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                 DragDrop.AllowDrop="True"
                 DragDrop.DragOver="ProfileList_DragOver"
                 DragDrop.DragLeave="SortList_DragLeave"
                 DragDrop.Drop="ProfileList_Drop"
                 PointerPressed="ProfileList_PointerPressed"
                 PointerMoved="ProfileList_PointerMoved"
                 ContextRequested="ProfileList_ContextRequested">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="10,7">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="默认 · 不可删除" Classes="caption-text" IsVisible="{Binding IsDefault}"/>
                  <TextBlock Text="{Binding ModCount, StringFormat='{}{0} 个模组'}" Classes="caption-text"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsActive}">
                  <TextBlock Text="当前" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 顶部搜索与批量操作栏，沿用模组库的布局和组件样式。 -->
    <Border Grid.Row="0" Grid.Column="1" Classes="card" Padding="12,10" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <Grid>
          <controls:UtilityIcon Kind="Search" ZIndex="1" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
          <TextBox x:Name="ProfileModSearchBox" PlaceholderText="搜索当前配置的模组…" Text="{Binding ModSearchText}" Padding="34,6,12,6" VerticalAlignment="Center"/>
        </Grid>
        <Button Grid.Column="1" Classes="icon-button" Command="{Binding ClearModSearchCommand}" ToolTip.Tip="清除搜索" Margin="6,0,0,0" VerticalAlignment="Center">
          <controls:UtilityIcon Kind="BackspaceQWERTY"/>
        </Button>
      </Grid>
      <WrapPanel x:Name="ProfileSelectionToolbar" Grid.Row="1" IsVisible="{Binding HasSelectedMods}">
        <Border Background="{DynamicResource SelectedSurfaceBrush}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,4">
          <TextBlock Text="{Binding SelectedModCount, StringFormat='已选择 {0} 个模组'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
        <Button Content="全选 / 取消全选" Command="{Binding ToggleSelectAllModsCommand}" Classes="secondary" Margin="0,0,8,4"/>
        <Button Content="反选" Command="{Binding InvertModSelectionCommand}" Classes="secondary" Margin="0,0,8,4"/>
        <Button Content="启用" Command="{Binding BatchEnableModsCommand}" Classes="secondary" Margin="0,0,8,4"/>
        <Button Content="禁用" Command="{Binding BatchDisableModsCommand}" Classes="secondary" Margin="0,0,8,4"/>
        <Button Content="移出配置" Command="{Binding RemoveSelectedModsCommand}" Classes="secondary" Margin="0,0,8,4" ToolTip.Tip="从正在查看的配置文件移除选中模组"/>
        <Button Content="清空选择" Command="{Binding ClearModSelectionCommand}" Classes="tertiary" Margin="0,0,8,4"/>
      </WrapPanel>
      </Grid>
    </Border>

    <!-- ══ 模组卡片列表 + 状态 + 添加模组抽屉 ══ -->
    <Grid x:Name="ProfileModArea" Grid.Row="1" Grid.Column="1">
      <!-- 模组卡片列表（卡片可拖动排序，支持 Ctrl 多选后整体拖动） -->
      <ScrollViewer x:Name="ModScrollViewer" IsVisible="{Binding IsProfileModsContentVisible}"
                    Background="Transparent" PointerPressed="ModBackground_PointerPressed">
        <ItemsControl x:Name="ModItemsControl" ItemsSource="{Binding ProfileRows}" Margin="0,-4,4,0" Focusable="True"
                      DragDrop.AllowDrop="True" DragDrop.DragOver="ModList_DragOver" DragDrop.DragLeave="SortList_DragLeave" DragDrop.Drop="ModList_Drop">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileModViewModel">
              <StackPanel>
                <Border IsVisible="{Binding IsSeparator}" Padding="12,8" Margin="0,8,0,4"
                        Classes="profile-separator" Background="{DynamicResource Surface3Brush}"
                        PointerPressed="ModCard_PointerPressed" PointerMoved="ModCard_PointerMoved"
                        ContextRequested="ModCard_ContextRequested"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,1">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Panel Width="6">
                      <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"/>
                      <Border Background="{Binding SeparatorColorBrush}" IsVisible="{Binding HasCustomSeparatorColor}" CornerRadius="3"/>
                    </Panel>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Button Classes="icon-button group-toggle" ToolTip.Tip="收起 / 展开分组"
                              Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).ToggleSeparatorCommand}" CommandParameter="{Binding}">
                        <Panel>
                          <controls:UtilityIcon Kind="Chevron" IsVisible="{Binding IsCollapsed}"/>
                          <controls:UtilityIcon Kind="Chevron" IsVisible="{Binding IsExpanded}" RenderTransformOrigin="50%,50%">
                            <controls:UtilityIcon.RenderTransform><RotateTransform Angle="90"/></controls:UtilityIcon.RenderTransform>
                          </controls:UtilityIcon>
                        </Panel>
                      </Button>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding ModName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GroupModCount, StringFormat='{}{0} 个模组'}" Classes="caption-text"/>
                        <TextBlock IsVisible="{Binding !IsUserSeparator}" Text="{Binding ModVersion}" Classes="caption-text" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="icon-button" Click="SeparatorMenu_Click" ToolTip.Tip="分组操作">
                        <controls:UtilityIcon Kind="More"/>
                      </Button>
                    </Grid>
                  </Grid>
                </Border>
                <!-- 使用 FluentAvalonia 原生 ListBoxItem 选中模板，保持与模组库单选效果一致。 -->
                <ListBoxItem Theme="{StaticResource ModCardListBoxItemTheme}" Classes="profile-mod-item" IsVisible="{Binding !IsSeparator}">
                  <Border x:Name="ProfileTutorialCard" Classes="mod-card"
                          PointerPressed="ModCard_PointerPressed" PointerMoved="ModCard_PointerMoved"
                          ContextRequested="ModCard_ContextRequested">
                    <Grid ColumnDefinitions="52,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                    <!-- 图标槽与顺序胶囊独立。 -->
                    <Border Grid.RowSpan="2" Width="52" Height="52" CornerRadius="6" Background="{DynamicResource Surface3Brush}"
                            Tapped="PreviewImage_Tapped" Cursor="Hand" ToolTip.Tip="列表顺序：{Binding PositionText}（右键可输入目标位置）">
                      <Panel>
                        <Image Source="{Binding Icon}" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding ModName}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ModName}"/>
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="chip">
                        <TextBlock Text="{Binding PositionText}" FontSize="12" Classes="muted"/>
                      </Border>
                      <Border Classes="chip">
                        <TextBlock Text="{Binding ModVersion, StringFormat='v{0}'}" FontSize="12" Classes="muted"/>
                      </Border>
                      <Border Classes="chip" IsVisible="{Binding IsLuaMod}">
                        <TextBlock Text="Lua Mods" FontSize="12" Classes="accent-text"/>
                      </Border>
                      <TextBlock Text="已启用" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding Enabled}"/>
                      <TextBlock Text="已停用" FontSize="12" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !Enabled}"/>
                      <TextBlock Text="含选项" FontSize="12" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasOptions}"/>
                      <TextBlock Text="{Binding PriorityLabel}" FontSize="12" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsBslMember}"/>
                      <TextBlock Text="位置固定" FontSize="12" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !CanDrag}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Grid.RowSpan="2" Classes="icon-button" VerticalAlignment="Center"
                            IsVisible="{Binding HasOptions}"
                            Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).OpenModOptionsCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="模组选项（部署时按所选选项收集文件）">
                      <controls:UtilityIcon Kind="MultiSelect"/>
                    </Button>
                    <ToggleSwitch Grid.Column="3" Grid.RowSpan="2" IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).ToggleModEnabledCommand}"
                                  CommandParameter="{Binding}" OnContent="" OffContent=""
                                  VerticalAlignment="Center" ToolTip.Tip="启用/禁用（部署时仅部署已启用的模组）"/>
                    <Button Grid.Column="4" Grid.RowSpan="2" Classes="icon-button" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).RemoveModFromProfileCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="从配置文件移除">
                      <controls:UtilityIcon Kind="Close" Foreground="{DynamicResource ErrorBrush}"/>
                    </Button>

                    </Grid>
                  </Border>
                </ListBoxItem>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 加载中 -->
      <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding IsProfileModsLoadingStateVisible}">
        <TextBlock Text="正在加载模组…" Classes="muted" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- 未选择配置文件 -->
      <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding HasNoSelectedProfile}">
        <TextBlock Text="从左侧选择一个配置文件查看模组" Classes="muted" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- 空配置 -->
      <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding IsProfileModsEmptyStateVisible}">
        <TextBlock Text="此配置文件暂未添加模组" Classes="muted" HorizontalAlignment="Center"/>
        <TextBlock Text="可通过左侧“添加模组”从模组库加入" Classes="caption-text" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- 搜索无结果 -->
      <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding HasNoModResults}">
        <TextBlock Text="没有匹配的模组，换个关键词试试" Classes="muted" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- 加载失败 -->
      <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding IsProfileModsErrorStateVisible}">
        <TextBlock Text="{Binding ProfileModsErrorMessage}" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
        <Button Classes="secondary" Command="{Binding RetryProfileModsCommand}" HorizontalAlignment="Center">重试</Button>
      </StackPanel>

      <!-- 添加模组抽屉（旧版侧栏抽屉造型） -->
      <Border IsVisible="{Binding IsAddModOpen}" Width="320" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Classes="card" Padding="12" ZIndex="2" Margin="0,0,0,4">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="从模组库添加" Classes="section-title"/>
              <TextBlock Text="点击 + 加入当前配置文件" Classes="caption-text"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="icon-button" Command="{Binding CloseAddModCommand}" ToolTip.Tip="关闭">
              <controls:UtilityIcon Kind="Close"/>
            </Button>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding AvailableLibraryMods}" Margin="0,10,0,0" IsVisible="{Binding !HasNoAvailableMods}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryModChoiceViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="6,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Version}" Classes="caption-text"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon-button" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).AddModToProfileCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="添加到配置文件">
                    <controls:UtilityIcon Kind="Add"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="模组库中的模组都已加入当前配置文件。" Classes="muted"
                     VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding HasNoAvailableMods}"/>
        </Grid>
      </Border>
    </Grid>

    <!-- 右键模组卡片后的定位输入面板；使用不透明主题背景，不受卡片透明度影响。 -->
    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
            IsVisible="{Binding IsMoveToPositionDialogOpen}" Background="{DynamicResource OverlayScrimBrush}" ZIndex="50">
      <Border Name="MoveToPositionDialogSurface" Classes="card" Background="{DynamicResource Surface2Brush}"
              Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="移动到指定位置" Classes="section-title"/>
          <TextBlock Text="已选择的模组将按当前相对顺序移动，位置 1 表示列表顶部。" Classes="caption-text" TextWrapping="Wrap"/>
          <TextBox Text="{Binding MoveToPositionText}" PlaceholderText="输入位置数字" HorizontalContentAlignment="Left"/>
          <TextBlock Text="{Binding MoveToPositionError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasMoveToPositionError}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="取消" Command="{Binding CancelMoveToPositionCommand}" Classes="secondary"/>
            <Button Content="移动" Command="{Binding ConfirmMoveToPositionCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ══ 底部操作栏（旧版仅右侧按钮，无重复状态文字）══ -->
    <Border Grid.Row="2" Grid.Column="1" Classes="card" Padding="12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CleanupDeploymentButton" Classes="secondary"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel.CleanupCommand}"
                IsEnabled="{Binding HasSelectedProfile}" ToolTip.Tip="清理当前已部署的模组文件">清理当前部署</Button>
        <Button x:Name="DeployCurrentProfileButton" Classes="accent"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel.DeployCommand}"
                CommandParameter="{Binding SelectedProfile.Id}"
                IsEnabled="{Binding HasSelectedProfile}" ToolTip.Tip="按列表顺序部署当前配置文件中已启用的模组">部署当前配置文件</Button>
        <Button x:Name="LaunchHd2Button" Classes="secondary"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel.LaunchGameCommand}"
                ToolTip.Tip="通过 Steam 启动 Helldivers 2">启动 HD2</Button>
      </StackPanel>
    </Border>

    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="40"
            DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel}"
            x:DataType="vm:LibraryViewModel" IsVisible="{Binding IsDeploying}"
            Background="{DynamicResource OverlayScrimBrush}">
      <Border Name="DeploymentOperationSurface" Classes="card" Background="{DynamicResource Surface2Brush}" Width="520" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="部署操作" Classes="section-title"/>
          <ProgressBar IsIndeterminate="True"/>
          <TextBlock Text="{Binding DeploymentMessage}" TextWrapping="Wrap"/>
          <Button Command="{Binding CancelDeploymentCommand}" HorizontalAlignment="Right">取消</Button>
        </StackPanel>
      </Border>
    </Border>

    <!-- ══ 模组选项覆盖层（应用内模态弹窗：v1 选项卡片+子选项多选一 / v0 互斥单选，带预览图）══ -->
    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
            IsVisible="{Binding IsModOptionsDialogOpen}" Background="{DynamicResource OverlayScrimBrush}" ZIndex="20">
      <Border Name="ModOptionsDialogSurface" Classes="card" Background="{DynamicResource Surface2Brush}" Width="680" MaxHeight="660"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- 标题栏 -->
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="模组选项" Classes="section-title"/>
                <TextBlock Text="{Binding ModOptionsDialog.Title}" Classes="caption-text" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="icon-button" VerticalAlignment="Center"
                      Command="{Binding CloseModOptionsCommand}" ToolTip.Tip="关闭">
                <controls:UtilityIcon Kind="Close"/>
              </Button>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" Padding="16,8">
            <StackPanel>
              <!-- v1：选项卡片（独立开关 + 子选项多选一） -->
              <ItemsControl ItemsSource="{Binding ModOptionsDialog.OptionCards}"
                            IsVisible="{Binding !ModOptionsDialog.IsLegacyMode}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileModOptionCardViewModel">
                    <Border Classes="option-card" Margin="0,6">
                      <StackPanel>
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                          <Border Width="64" Height="64" CornerRadius="6" Background="{DynamicResource Surface3Brush}"
                                  Tapped="PreviewImage_Tapped" Cursor="Hand" ToolTip.Tip="点击预览原图">
                            <Panel>
                              <TextBlock Text="无预览" Classes="caption-text" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" IsVisible="{Binding !HasImage}"/>
                              <Image Source="{Binding Image}" Width="64" Height="64" Stretch="Uniform"/>
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}" Classes="caption-text" TextWrapping="Wrap"
                                       IsVisible="{Binding HasDescription}"/>
                          </StackPanel>
                          <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                    Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).ModOptionsDialog.ToggleOptionCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="启用/停用该选项（停用后其文件不参与部署）"/>
                        </Grid>

                        <!-- 子选项默认收起，按需展开后多选一，点选高亮。 -->
                        <Expander Header="子选项" IsExpanded="False" Margin="0,8,0,0"
                                  HorizontalAlignment="Stretch" IsVisible="{Binding HasSubOptions}">
                          <ItemsControl ItemsSource="{Binding SubOptions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileModSubOptionChoiceViewModel">
                              <ListBoxItem Theme="{StaticResource ViewModelSelectableListBoxItemTheme}" Classes="option-choice-item"
                                           Tapped="SubChoice_Tapped">
                                <Border Classes="sub-choice">
                                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource Surface3Brush}"
                                            Tapped="PreviewImage_Tapped" Cursor="Hand" ToolTip.Tip="点击预览原图">
                                      <Image Source="{Binding Image}" Width="40" Height="40" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding Name}"/>
                                      <TextBlock Text="{Binding Description}" Classes="caption-text"
                                                 TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </ListBoxItem>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- v0：互斥选择列表（部署时只使用选中的那个子目录） -->
              <ItemsControl ItemsSource="{Binding ModOptionsDialog.LegacyChoices}"
                            IsVisible="{Binding ModOptionsDialog.IsLegacyMode}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileModLegacyChoiceViewModel">
                    <ListBoxItem Theme="{StaticResource ViewModelSelectableListBoxItemTheme}" Classes="option-choice-item"
                                 Tapped="LegacyChoice_Tapped">
                      <Border Classes="sub-choice">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                      </Border>
                    </ListBoxItem>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- 底部 -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption-text" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460"
                         Text="取消勾选的选项在部署时会被排除；带变体的选项只部署选中变体的文件；全部取消时该模组不部署任何文件。选择按配置文件分别保存。"/>
              <Button Grid.Column="1" Classes="accent" Command="{Binding CloseModOptionsCommand}"
                      VerticalAlignment="Center">完成</Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>

    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
            IsVisible="{Binding IsSeparatorDialogOpen}" Background="{DynamicResource OverlayScrimBrush}" ZIndex="25">
      <Border Classes="card" Background="{DynamicResource Surface2Brush}" Width="420" Padding="20"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding SeparatorDialogTitle}" Classes="section-title"/>
          <TextBox x:Name="SeparatorNameInput" Text="{Binding SeparatorName}" IsReadOnly="{Binding !IsSeparatorNameEditable}" PlaceholderText="例如：武器、护甲、界面"/>
          <CheckBox x:Name="UseThemeSeparatorColor" Content="颜色跟随主题" IsChecked="{Binding UseDefaultSeparatorColor}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="分组颜色" VerticalAlignment="Center"/>
            <ColorPicker x:Name="SeparatorColorPicker" Grid.Column="1" Color="{Binding SeparatorSelectedColor, Mode=TwoWay}"
                         IsEnabled="{Binding !UseDefaultSeparatorColor}" IsAlphaEnabled="False" IsAlphaVisible="False"/>
          </Grid>
          <TextBlock Text="{Binding SeparatorError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelSeparatorDialogCommand}" Classes="tertiary"/>
            <Button x:Name="SaveProfileSeparatorButton" Content="保存" Command="{Binding ConfirmSeparatorCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- 排序预览不参与命中测试和列表布局，避免虚影改变真实落点。 -->
    <Canvas x:Name="SortPreviewLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="300"
            IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="SortInsertionMarker" IsVisible="False" Height="3"
              Background="{DynamicResource AccentBrush}" CornerRadius="2"/>
      <Border x:Name="SortDragGhost" IsVisible="False" Opacity="0.82" Padding="12,8"
              Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}">
        <StackPanel Spacing="4">
          <TextBlock x:Name="SortDragTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SortDragDestination" Classes="caption-text" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</UserControl>
