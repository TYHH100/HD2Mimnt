<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             x:Class="HD2Mimnt.UI.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="配置文件" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="管理不同的模组组合与启用状态" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Width="180" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="新配置名称"/>
                <Button Content="新建配置文件" Command="{Binding CreateProfileCommand}" Classes="primary" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,20,0,12">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索配置文件"/>
            <TextBlock Grid.Column="1" Text="按名称或描述搜索" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
            <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid>
                <ListBox ItemsSource="{Binding VisibleProfiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0" IsVisible="{Binding !IsEmpty}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileItemViewModel">
                            <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource Surface3Brush}" CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0"/>
                                            <Border Background="#22C55E" CornerRadius="4" Padding="5,2" IsVisible="{Binding IsActive}">
                                                <TextBlock Text="当前配置" FontSize="11" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ModCount, StringFormat='模组 {0} 个'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="切换" Command="{Binding $parent[UserControl].DataContext.SetActiveProfileCommand}" CommandParameter="{Binding}" Classes="secondary" IsVisible="{Binding !IsActive}"/>
                                        <Button Content="复制" Command="{Binding $parent[UserControl].DataContext.DuplicateProfileCommand}" CommandParameter="{Binding}" Classes="secondary"/>
                                        <Button Content="重命名" Command="{Binding $parent[UserControl].DataContext.RenameProfileCommand}" CommandParameter="{Binding}" Classes="secondary"/>
                                        <Button Content="删除" Command="{Binding $parent[UserControl].DataContext.DeleteProfileCommand}" CommandParameter="{Binding}" Classes="secondary"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="还没有配置文件" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="在上方输入名称创建第一个配置" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="没有匹配的配置文件" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Button Content="清除搜索" Command="{Binding ClearSearchCommand}" Classes="secondary" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="配置文件加载失败" FontSize="18" Foreground="#EF4444" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="重试" Command="{Binding LoadProfilesCommand}" Classes="primary" HorizontalAlignment="Center"/>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" IsVisible="{Binding !IsCompareOpen}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Spacing="4">
                        <TextBlock Text="配置详情" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='请选择配置文件'}" FontSize="16" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding SelectedProfile.Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Button Content="比较配置文件" Command="{Binding OpenCompareCommand}" CommandParameter="{Binding SelectedProfile}" Classes="secondary" HorizontalAlignment="Left" IsEnabled="{Binding SelectedProfile}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,18,0,10">
                        <TextBlock Text="配置中的模组" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProfileMods.Count, StringFormat='{}{0} 个'}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ProfileMods}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileModViewModel">
                                <Border Padding="8,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ModVersion}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Command="{Binding $parent[UserControl].DataContext.ToggleModEnabledCommand}" CommandParameter="{Binding}" Content="启用" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" IsVisible="{Binding IsCompareOpen}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="配置文件对比" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="只读查看两个配置文件的模组差异" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCompareCommand}" Classes="secondary"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="10" Margin="0,18,0,12">
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CompareLeftProfile}" DisplayMemberBinding="{Binding Name}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding CompareRightProfile}" DisplayMemberBinding="{Binding Name}"/>
                        <ComboBox Grid.Column="2" Width="130" ItemsSource="{Binding CompareFilterOptions}" SelectedItem="{Binding CompareFilter}"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding CompareResults}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileCompareItemViewModel">
                                <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding IsVisible}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LeftState}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RightState}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="#38BDF8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
