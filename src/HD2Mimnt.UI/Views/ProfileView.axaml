<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HD2Mimnt.UI.ViewModels"
             xmlns:controls="using:HD2Mimnt.UI.Controls"
             x:Class="HD2Mimnt.UI.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,16,24,20">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="配置文件" Classes="page-title" />
        <TextBlock Text="为不同模组组合保存独立的启用状态与部署顺序。" Classes="page-subtitle" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBox Width="220" PlaceholderText="新配置文件名称" Text="{Binding NewProfileName}" />
        <Button Classes="accent" Command="{Binding CreateProfileCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:UtilityIcon Kind="Add" Width="14" Height="14"/><TextBlock Text="新建配置文件" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="280,*,360" ColumnSpacing="16" Margin="0,0,0,16">
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Classes="section">
        <TextBox PlaceholderText="搜索配置文件" Text="{Binding SearchText}" Margin="0,0,0,8" />
        <ListBox Grid.Row="1" ItemsSource="{Binding VisibleProfiles}" SelectedItem="{Binding SelectedProfile}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="8,7">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding ModCount, StringFormat='{}{0} 个模组'}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="1" Text="当前" Foreground="#54B8B0" IsVisible="{Binding IsActive}" FontSize="12" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
          <Button Command="{Binding SetActiveProfileCommand}" CommandParameter="{Binding SelectedProfile}" IsEnabled="{Binding HasSelectedProfile}">设为当前</Button>
          <Button Command="{Binding DuplicateProfileCommand}" CommandParameter="{Binding SelectedProfile}" IsEnabled="{Binding HasSelectedProfile}">复制</Button>
          <Button Command="{Binding DeleteProfileCommand}" CommandParameter="{Binding SelectedProfile}" IsEnabled="{Binding HasSelectedProfile}">删除</Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Classes="section">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding SelectedProfile.Name}" Classes="section-title" />
            <TextBlock Text="{Binding SelectedProfile.Description}" Classes="muted" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Content="重命名" Command="{Binding RenameProfileCommand}" CommandParameter="{Binding SelectedProfile}" IsEnabled="{Binding HasSelectedProfile}" />
        </Grid>
        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12" />
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="已启用模组" Classes="section-title" />
            <Button Grid.Column="1" Content="添加模组" Command="{Binding OpenAddModCommand}" IsEnabled="{Binding HasSelectedProfile}" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding ProfileMods}" IsVisible="{Binding IsProfileModsContentVisible}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileModViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,7" ColumnSpacing="10">
                  <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).ToggleModEnabledCommand}" CommandParameter="{Binding}" />
                  <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding ModName}" /><TextBlock Text="{Binding ModVersion}" Classes="muted" FontSize="12" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Order, StringFormat='#{0}'}" Classes="muted" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Content="移除" Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).RemoveModFromProfileCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="选择配置文件后查看模组。" Classes="muted" IsVisible="{Binding HasNoSelectedProfile}" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="此配置文件暂未添加模组。" Classes="muted" IsVisible="{Binding IsProfileModsEmptyStateVisible}" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Classes="section">
        <TextBlock Text="部署" Classes="section-title" />
        <TextBlock Grid.Row="1" Text="直接对当前配置文件执行部署或清理，状态会同步到任务中心。" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,16" />
        <StackPanel Grid.Row="2" Spacing="10">
          <Button Classes="accent" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel.DeployCommand}" IsEnabled="{Binding HasSelectedProfile}">部署当前配置文件</Button>
          <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryViewModel.CleanupCommand}" IsEnabled="{Binding HasSelectedProfile}">清理当前部署</Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="4" Margin="0,16,0,0"><TextBlock Text="配置文件状态" Classes="muted" FontSize="12" /><TextBlock Text="{Binding SelectedProfile.IsActive, StringFormat='当前配置：{0}'}" /></StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" IsVisible="{Binding IsAddModOpen}" Classes="section" Padding="12" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
        <TextBlock Text="从模组库添加" Classes="section-title" />
        <Button Grid.Column="1" Content="关闭" Command="{Binding CloseAddModCommand}" />
        <ListBox Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding AvailableLibraryMods}" Margin="0,10,0,0">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryModChoiceViewModel"><Button HorizontalContentAlignment="Left" Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).AddModToProfileCommand}" CommandParameter="{Binding}"><TextBlock Text="{Binding Name}" /></Button></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <TextBlock Grid.Row="3" Text="提示：启用状态只影响配置文件，实际文件变更在部署后生效。" Classes="muted" />
  </Grid>
</UserControl>
