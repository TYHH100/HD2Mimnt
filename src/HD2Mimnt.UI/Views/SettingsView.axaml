<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <Grid ColumnDefinitions="180,*" Margin="24,16,24,20" ColumnSpacing="24">
    <StackPanel Grid.Column="0" Spacing="4">
      <TextBlock Text="设置" Classes="page-title" Margin="0,0,0,12" />
      <ListBox ItemsSource="{Binding SettingsCategories}" SelectedItem="{Binding SelectedCategory}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Padding="8,9" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel>
    <ScrollViewer Grid.Column="1"><StackPanel MaxWidth="760" Spacing="0">
      <TextBlock Text="应用设置" Classes="section-title" Margin="0,0,0,4" /><TextBlock Text="管理游戏路径、部署默认值和界面偏好。" Classes="page-subtitle" Margin="0,0,0,18" />
      <StackPanel IsVisible="{Binding IsGameCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="游戏目录" Classes="section-title" /><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Helldivers 2 安装目录" /><Button Grid.Column="1" Content="验证" Command="{Binding ValidateGameCommand}" /><Button Grid.Column="2" Content="自动识别" Command="{Binding DetectGameCommand}" /></Grid><CheckBox Content="启动时自动识别游戏" IsChecked="{Binding AutoDetectGame}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsProfileCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="配置文件" Classes="section-title" /><CheckBox Content="在列表中点击配置文件时自动应用为当前（默认开启）" IsChecked="{Binding AutoSwitchProfileOnSelect}" /><TextBlock Text="关闭后需右键配置文件选择“设为当前”来切换。" Classes="muted" FontSize="11" /></StackPanel>
      <StackPanel IsVisible="{Binding IsDeploymentCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="部署" Classes="section-title" /><Grid ColumnDefinitions="220,*" ColumnSpacing="12"><TextBlock Text="默认部署方式" VerticalAlignment="Center" Classes="muted" /><ComboBox Grid.Column="1" ItemsSource="{Binding DeploymentMethods}" SelectedItem="{Binding DefaultDeploymentMethod}" HorizontalAlignment="Left" Width="220" /></Grid><CheckBox Content="部署前检查目标目录" IsChecked="{Binding CheckBeforeDeploy}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsLibraryCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="模组库" Classes="section-title" /><Grid ColumnDefinitions="220,*" ColumnSpacing="12"><TextBlock Text="默认筛选" VerticalAlignment="Center" Classes="muted" /><ComboBox Grid.Column="1" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding DefaultFilterType}" HorizontalAlignment="Left" Width="220" /></Grid><CheckBox Content="显示模组缩略图" IsChecked="{Binding ShowThumbnails}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsAppearanceCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="外观" Classes="section-title" /><Grid ColumnDefinitions="220,*" ColumnSpacing="12"><TextBlock Text="主题" VerticalAlignment="Center" Classes="muted" /><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" HorizontalAlignment="Left" Width="220" /></Grid><Grid ColumnDefinitions="220,*" ColumnSpacing="12"><TextBlock Text="列表密度" VerticalAlignment="Center" Classes="muted" /><ComboBox Grid.Column="1" ItemsSource="{Binding ListDensityOptions}" SelectedItem="{Binding ListDensity}" HorizontalAlignment="Left" Width="220" /></Grid><CheckBox Content="启用界面动画" IsChecked="{Binding EnableAnimations}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsAppearanceCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="自定义背景与透明度" Classes="section-title" /><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding BackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="背景图片路径（留空禁用）" /><Button Grid.Column="1" Content="选择图片" Click="OnPickBackgroundClicked" /><Button Grid.Column="2" Content="清除" Command="{Binding ClearBackgroundImageCommand}" /></Grid><Grid ColumnDefinitions="220,*,56" ColumnSpacing="12"><TextBlock Text="背景图片不透明度" VerticalAlignment="Center" Classes="muted" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BackgroundImageOpacity}" /><TextBlock Grid.Column="2" Text="{Binding BackgroundImageOpacity, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" Classes="muted" /></Grid><Grid ColumnDefinitions="220,*,56" ColumnSpacing="12"><TextBlock Text="背景图片模糊" VerticalAlignment="Center" Classes="muted" /><Slider Grid.Column="1" Minimum="0" Maximum="40" Value="{Binding BackgroundBlur}" /><TextBlock Grid.Column="2" Text="{Binding BackgroundBlur, StringFormat='{}{0:0}'}" VerticalAlignment="Center" Classes="muted" /></Grid><Grid ColumnDefinitions="220,*,56" ColumnSpacing="12"><TextBlock Text="卡片不透明度" VerticalAlignment="Center" Classes="muted" /><Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding CardOpacity}" /><TextBlock Grid.Column="2" Text="{Binding CardOpacity, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" Classes="muted" /></Grid><TextBlock Text="调低卡片不透明度后卡片会透出背景图片；背景图片本身可加模糊保证文字可读。保存设置后生效。" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
      <StackPanel IsVisible="{Binding IsCacheCategoryVisible}" Classes="section" Spacing="12"><TextBlock Text="缓存" Classes="section-title" /><TextBlock Text="{Binding CacheStatus}" Classes="muted" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="刷新信息" Command="{Binding RefreshCacheCommand}" /><Button Content="清理图片缓存" Command="{Binding ClearImageCacheCommand}" /></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,20,0,0"><Button Content="保存设置" Classes="accent" Command="{Binding SaveCommand}" /><Button Content="恢复默认" Command="{Binding ResetCommand}" /><TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" /></StackPanel>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
