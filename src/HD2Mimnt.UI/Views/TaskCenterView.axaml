<UserControl xmlns="https://github.com/avaloniaui" xmlns:loc="using:HD2Mimnt.UI.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:HD2Mimnt.UI.ViewModels" x:Class="HD2Mimnt.UI.Views.TaskCenterView" x:DataType="vm:TaskCenterViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{loc:Loc UI.TaskCenter}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{loc:LocalizedBinding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Button x:Name="ClearFinishedButton" Grid.Column="1" VerticalAlignment="Top" Content="{loc:Loc UI.ClearCompletedTasks}" Command="{Binding ClearFinishedCommand}" Classes="secondary" IsVisible="{Binding HasFinishedTasks}" ToolTip.Tip="{loc:Loc UI.ClearCompletedTasksHint}"/></Grid>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <ListBox ItemsSource="{Binding Tasks}" IsVisible="{Binding !IsEmpty}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,12,0,1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><StackPanel><TextBlock Text="{loc:LocalizedBinding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentItem}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Row="1" Text="{loc:LocalizedBinding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><ProgressBar Grid.Row="2" Value="{Binding Progress}" IsIndeterminate="{Binding Progress, Converter={StaticResource EqualConverter}, ConverterParameter=0}" Height="4" Margin="0,7,0,0"/><StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"><Button Content="{loc:Loc Common.Cancel}" Command="{Binding $parent[UserControl].DataContext.CancelCommand}" CommandParameter="{Binding}" Classes="secondary" IsVisible="{Binding Status, Converter={StaticResource EqualConverter}, ConverterParameter=Running}"/><Button Content="{loc:Loc Common.Delete}" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding}" Classes="secondary" IsVisible="{Binding Status, Converter={StaticResource FinishedTaskConverter}}" ToolTip.Tip="{loc:Loc UI.DeleteTaskRecord}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{loc:Loc UI.NoBackgroundTasks}" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="{loc:Loc UI.ImportScanAndDeploymentTasksAppearHereWhenCompleted}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/></StackPanel>
      <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{loc:Loc UI.FailedToLoadTaskCenter}" FontSize="18" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/><TextBlock Text="{loc:LocalizedBinding ErrorMessage}" TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextSecondaryBrush}"/><Button Content="{loc:Loc UI.Retry}" Command="{Binding LoadCommand}" Classes="accent" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>
